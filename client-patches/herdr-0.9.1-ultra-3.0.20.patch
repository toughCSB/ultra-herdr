+use super::*;
+
+fn claude_history(colors: (u32, u32), background: u32) -> ClientShellState {
+    let mut state = state(
+        "claude",
+        colors,
+        &[
+            "",
+            "❯ 질문 漢字",
+            "  wrapped continuation",
+            "",
+            "⏺ assistant",
+            "  tool output",
+            "",
+            "──────────────",
+            "❯\u{a0}",
+            "──────────────",
+        ],
+    );
+    let source = state.pane_surface.as_mut().unwrap();
+    for y in 1..=2 {
+        // Captured Ink rows paint only the visible message, not terminal padding.
+        let row = &mut source.frame.cells[y * 40..(y + 1) * 40];
+        let end = row
+            .iter()
+            .rposition(|cell| !cell.symbol.trim().is_empty())
+            .unwrap()
+            + 1;
+        for cell in &mut row[..end] {
+            cell.fg = 0x02999999;
+            cell.bg = background;
+        }
+    }
+    state
+}
+
+#[test]
+fn claude_history_uses_workspace_colors_without_hardcoding_source_gray() {
+    for colors in THEMES {
+        for gray in [0x02373737, 0x02eeeeee] {
+            // Given a captured-style history followed by tool text and the ruled composer.
+            let mut state = claude_history(colors, gray);
+            let original = state.pane_surface.as_ref().unwrap().frame.clone();
+            // When composing.
+            let frame = state.compose(106, 24).unwrap();
+            // Then history, including the wrapped CJK cells, is distinct; other roles are unchanged.
+            for y in 0..12 {
+                let actual = composed_row(&state, &frame, y);
+                let raw = &original.cells[usize::from(y) * 40..usize::from(y + 1) * 40];
+                if (1..=2).contains(&y) {
+                    for (cell, source) in actual.iter().zip(raw) {
+                        assert_eq!((cell.bg, cell.fg), colors);
+                        assert_eq!((&cell.symbol, cell.skip), (&source.symbol, source.skip));
+                    }
+                } else {
+                    let mut expected = raw.to_vec();
+                    for cell in &mut expected {
+                        apply_terminal_colors(
+                            cell,
+                            terminal_colors(state.snapshot.as_deref().unwrap()),
+                        );
+                    }
+                    assert_eq!(actual, expected);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn claude_menu_markers_and_plain_prompt_are_not_history() {
+    // Given Claude menus and a composer, all without a history background.
+    let mut state = state(
+        "claude",
+        THEMES[0],
+        &[
+            "❯ 1. Yes",
+            "  2. No",
+            "",
+            "❯ Model option",
+            "",
+            "────────",
+            "❯\u{a0}draft",
+            "────────",
+        ],
+    );
+    // When composing.
+    let frame = state.compose(106, 24).unwrap();
+    // Then matching glyphs alone never acquire the card background.
+    for y in 0..8 {
+        assert!(composed_row(&state, &frame, y)
+            .iter()
+            .all(|cell| cell.bg != THEMES[0].0));
+    }
+}
+
+#[test]
+fn claude_background_change_patch_stops_unmodified_continuations() {
+    // Given a Claude card and the same independent full-frame fixture.
+    let mut state = claude_history(THEMES[1], 0x02373737);
+    let mut fresh = claude_history(THEMES[1], 0x02373737);
+    state.compose(106, 24).unwrap();
+    let source = state.pane_surface.as_ref().unwrap();
+    let mut cell = source.frame.cells[82].clone();
+    cell.bg = 0;
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: source.boot_id.clone(),
+        projection_revision: source.projection_revision,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows: vec![crate::protocol::PaneSurfacePatchRow {
+            x: 2,
+            y: 2,
+            cells: vec![cell.clone()],
+        }],
+        panes: source.panes.clone(),
+        cursor: None,
+    };
+    fresh.pane_surface.as_mut().unwrap().frame.cells[82] = cell;
+    // When a partial row loses its user background.
+    assert!(matches!(
+        state.apply_pane_surface_patch(patch),
+        ClientPaneSurfacePatchOutcome::Applied(None)
+    ));
+    let patched = state.compose(106, 24).unwrap();
+    let full = fresh.compose(106, 24).unwrap();
+    // Then source-dependent boundaries are recomputed rather than retaining a stale card.
+    assert_eq!(patched.cells, full.cells);
+    assert_eq!(composed_row(&state, &patched, 1)[0].bg, THEMES[1].0);
+    assert_ne!(composed_row(&state, &patched, 2)[0].bg, THEMES[1].0);
+}
