+#[test]
+fn workspace_selection_does_not_overwrite_its_status_badge() {
+    for (name, toml, json) in themes() {
+        let config = config(toml, json);
+        for status in [
+            AgentStatus::Idle,
+            AgentStatus::Working,
+            AgentStatus::Blocked,
+            AgentStatus::Done,
+        ] {
+            for selected in [false, true] {
+                let snapshot = data(status, false);
+                let workspace = &snapshot.workspaces[0];
+                let rows =
+                    super::super::sidebar::workspace_rows(workspace, status, false, &config.spaces);
+                let entry =
+                    super::super::sidebar::workspace_entries(&snapshot, &HashSet::new()).remove(0);
+                let rect = Rect::new(0, 0, 32, u16::try_from(rows.len()).expect("row count"));
+                let mut buffer = Buffer::empty(rect);
+                buffer.set_style(
+                    rect,
+                    Style::default()
+                        .fg(config.palette.text)
+                        .bg(config.palette.sidebar_bg),
+                );
+                super::super::sidebar::render_workspace_rows(
+                    &mut buffer,
+                    rect,
+                    workspace,
+                    status,
+                    &config,
+                    &entry,
+                    rows,
+                    true,
+                    selected,
+                    false,
+                    &config.palette,
+                );
+                sidebar_status::ensure_readable(&mut buffer, rect, &config);
+                let paint = sidebar_status::paint(&config, status).expect("status paint");
+                assert!(
+                    buffer
+                        .content
+                        .iter()
+                        .any(|cell| cell.symbol() == paint.icon && cell.bg == paint.row_background),
+                    "{name} {status:?} selected={selected} badge wiped"
+                );
+            }
+        }
+    }
+}
