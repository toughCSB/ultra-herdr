@@ -0,0 +1,50 @@
+use super::*;
+
+fn assert_readable(frame: &FrameData, area: Rect, label: &str) {
+    let mut checked = 0;
+    for y in area.y..area.bottom() {
+        for x in area.x..area.right() {
+            let cell = &frame.cells[usize::from(y) * usize::from(frame.width) + usize::from(x)];
+            if cell.symbol.trim().is_empty() { continue; }
+            let fg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.fg)).unwrap();
+            let bg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.bg)).unwrap();
+            let a = crate::ui::relative_luminance(fg); let b = crate::ui::relative_luminance(bg);
+            let contrast = (a.max(b) + 0.05) / (a.min(b) + 0.05);
+            assert!(contrast >= 4.5, "{label}: {:?} on {:?}, contrast {contrast}", fg, bg);
+            assert_eq!(cell.modifier & Modifier::DIM.bits(), 0, "{label} faded text");
+            checked += 1;
+        }
+    }
+    assert!(checked > 0, "{label} must contain text");
+}
+
+#[test]
+#[ignore = "requires ULTRA_HERDR_TEST_CONFIG generated by plugin applyTheme"]
+fn pink_new_tab_popup_and_created_tabs_have_readable_native_cells() {
+    let path = std::env::var("ULTRA_HERDR_TEST_CONFIG").unwrap();
+    let config: Config = toml::from_str(&std::fs::read_to_string(path).unwrap()).unwrap();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    state.open_new_tab_overlay();
+    state.handle_input_bytes("새 탭 logs".as_bytes());
+    let frame = state.compose(106, 24).unwrap();
+    assert_readable(&frame, state.hits.overlay_primary, "save");
+    assert_readable(&frame, state.hits.overlay_clear, "clear");
+    assert_readable(&frame, state.hits.overlay_cancel, "cancel");
+    // The input is two rows below the title in the same seven-row popup.
+    let area = Rect::new((106 - 56) / 2, (24 - 7) / 2, 56, 7);
+    assert_readable(&frame, Rect::new(area.x + 1, area.y + 3, area.width - 2, 1), "input");
+    let result = state.handle_input_bytes(b"\r");
+    assert!(!result.actions.is_empty());
+    let mut projection = state.snapshot.as_deref().unwrap().clone();
+    for tab in &mut projection.tabs { tab.focused = false; }
+    let mut added = projection.tabs[0].clone();
+    added.tab_id = "tab_new".into(); added.number = 2; added.label = "새 탭 logs".into();
+    added.custom_label = true; added.focused = true;
+    projection.tabs.push(added);
+    projection.focused_tab_id = Some("tab_new".into());
+    state.set_snapshot(Box::new(projection));
+    let frame = state.compose(106, 24).unwrap();
+    for (area, _) in &state.hits.tabs { assert_readable(&frame, *area, "created/focused/inactive tab"); }
+}
