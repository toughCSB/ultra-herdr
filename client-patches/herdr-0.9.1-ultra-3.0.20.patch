new file mode 100644
index 0000000..ab17bfc
--- /dev/null
+++ b/src/client/shell/tests/terminal_user_messages/live.rs
@@ -0,0 +1,130 @@
+use super::*;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+struct Captures {
+    samples: Vec<Sample>,
+}
+
+#[derive(Deserialize)]
+struct Sample {
+    name: String,
+    agent: String,
+    theme: String,
+    fragments: Vec<Fragment>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Fragment {
+    history_row: Option<u16>,
+    ansi: String,
+    columns: u16,
+}
+
+#[tokio::test]
+async fn actual_active_terminal_captures_render_distinct_user_cards() {
+    // Given captured live SGR and gutters, with private text masked at equal cell widths.
+    let captures: Captures = serde_json::from_str(include_str!("live_captures.json")).unwrap();
+    let mut fragments_checked = 0;
+    let mut user_rows_checked = 0;
+    for sample in &captures.samples {
+        let (colors, background, foreground) = match sample.theme.as_str() {
+            "blue" => (THEMES[0], "#000000", "#d4d4d4"),
+            "pink" => (THEMES[1], "#fffafa", "#30252b"),
+            "red" => (THEMES[2], "#0b0b0e", "#d4d4d4"),
+            other => panic!("unknown captured theme: {other}"),
+        };
+        for fragment in &sample.fragments {
+            let width = fragment.columns;
+            let height = u16::try_from(fragment.ansi.lines().count())
+                .unwrap()
+                .saturating_add(2);
+            let pane = crate::pane::PaneRuntime::test_with_screen_bytes(
+                width,
+                height,
+                fragment.ansi.as_bytes(),
+            );
+            let backend = ratatui::backend::TestBackend::new(width, height);
+            let mut terminal = ratatui::Terminal::new(backend).unwrap();
+            let mut source = surface();
+            terminal
+                .draw(|frame| {
+                    pane.render(frame, Rect::new(0, 0, width, height), false);
+                    source.frame = FrameData::from_ratatui_buffer_with_hyperlinks(
+                        frame.buffer_mut(),
+                        None,
+                        &[],
+                    );
+                })
+                .unwrap();
+            source.panes[0].rect = Rect::new(0, 0, width, height).into();
+            source.panes[0].inner_rect = source.panes[0].rect;
+            let raw = source.frame.clone();
+            let mut state = state(&sample.agent, colors, &[]);
+            let mut projection = state.snapshot.as_deref().unwrap().clone();
+            let tokens = &mut projection.workspaces[0].tokens;
+            tokens.retain(|(key, _)| {
+                !matches!(key.as_str(), "ultra_terminal_fg" | "ultra_terminal_bg")
+                    && (sample.theme == "pink" || key != "ultra_terminal_palette")
+            });
+            tokens.extend([
+                ("ultra_terminal_fg".into(), foreground.into()),
+                ("ultra_terminal_bg".into(), background.into()),
+            ]);
+            state.set_snapshot(Box::new(projection));
+            state.set_pane_surface(source);
+            // When real terminal parsing and native shell composition process the captured cells.
+            let frame = state
+                .compose(width.saturating_add(60), height.saturating_add(12))
+                .unwrap();
+            // Then history is colored, while composer, diff/model content, and geometry survive.
+            for y in 0..height {
+                let actual = composed_row(&state, &frame, y);
+                let row_start = usize::from(y) * usize::from(width);
+                let original = &raw.cells[row_start..row_start + usize::from(width)];
+                for (cell, before) in actual.iter().zip(original) {
+                    assert_eq!(
+                        (&cell.symbol, cell.skip, cell.hyperlink),
+                        (&before.symbol, before.skip, before.hyperlink),
+                        "{} row {y}",
+                        sample.name
+                    );
+                }
+                if fragment.history_row == Some(y) {
+                    assert!(
+                        actual.iter().all(|cell| (cell.bg, cell.fg) == colors),
+                        "{} history row {y} did not use the configured card colors",
+                        sample.name
+                    );
+                    user_rows_checked += 1;
+                } else if fragment.history_row.is_none()
+                    || original.iter().any(|cell| cell.bg == 0x02213a2b)
+                {
+                    let mut expected = original.to_vec();
+                    for cell in &mut expected {
+                        apply_terminal_colors(
+                            cell,
+                            terminal_colors(state.snapshot.as_deref().unwrap()),
+                        );
+                    }
+                    assert_eq!(actual, expected, "{} non-user row {y}", sample.name);
+                }
+            }
+            assert_eq!(
+                state.pane_surface.as_ref().unwrap().frame.cells,
+                raw.cells,
+                "{} source cells changed",
+                sample.name
+            );
+            fragments_checked += 1;
+        }
+    }
+    assert!(user_rows_checked > 0);
+    eprintln!(
+        "live_samples={} fragments={} user_rows={}",
+        captures.samples.len(),
+        fragments_checked,
+        user_rows_checked
+    );
+}
