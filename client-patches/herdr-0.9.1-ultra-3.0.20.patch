+        ] {
+            let pane = crate::pane::PaneRuntime::test_with_screen_bytes(80, 24, ansi.replace("\n", "\r\n").as_bytes());
+            let mut terminal = ratatui::Terminal::new(ratatui::backend::TestBackend::new(80, 24)).unwrap();
+            let mut source = surface();
+            terminal.draw(|frame| {
+                pane.render(frame, Rect::new(0, 0, 80, 24), false);
+                source.frame = FrameData::from_ratatui_buffer_with_hyperlinks(frame.buffer_mut(), None, &[]);
+            }).unwrap();
+            source.panes[0].rect = Rect::new(0, 0, 80, 24).into();
+            source.panes[0].inner_rect = source.panes[0].rect;
+            let mut state = themed_state(0, 0, false);
+            let mut snapshot = state.snapshot.as_deref().unwrap().clone();
+            snapshot.workspaces[0].tokens.retain(|(key, _)| key != "ultra_terminal_bg" && key != "ultra_terminal_palette");
+            snapshot.workspaces[0].tokens.extend([
