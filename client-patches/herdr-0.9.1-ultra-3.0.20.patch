+        .iter()
+        .find(|(_, id)| id == "pane_1")
+        .unwrap()
+        .0;
+    let second_row = state
+        .hits
+        .agents
+        .iter()
+        .find(|(_, id)| id == "pane_2")
+        .unwrap()
+        .0;
+    let first_cell = cell_symbol_position(&frame, first_row, "Claude");
+    assert_eq!(buffer[first_cell].fg, Color::Rgb(217, 119, 87));
+    assert_eq!(buffer[first_cell].bg, Color::Rgb(254, 186, 185));
+    let second_icon = cell_symbol_position(&frame, second_row, "●");
+    assert_eq!(buffer[second_icon].fg, Color::Rgb(166, 61, 0));
+    assert_eq!(buffer[second_icon].bg, Color::Rgb(255, 235, 234));
+    let provider_cell = cell_symbol_position(&frame, first_row, "\u{e1a0}");
