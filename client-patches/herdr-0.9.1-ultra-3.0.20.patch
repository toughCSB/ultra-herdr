+#[test]
+fn light_execution_theme_rebases_cached_neutral_surfaces_but_preserves_colored_diffs() {
+    let mut projection = snapshot();
+    projection.workspaces[0].tokens = vec![
+        ("ultra_terminal_fg".into(), "#30252b".into()),
+        ("ultra_terminal_bg".into(), "#fffafa".into()),
+    ];
+    let mut source = surface();
+    source.frame.cells[0].fg = 0x02cc_cccc;
+    source.frame.cells[0].bg = 0x0226_2626;
+    source.frame.cells[1].fg = 0x02cc_cccc;
+    source.frame.cells[1].bg = 0x0200_3311;
+    source.frame.cells[2].fg = 0x0000_0010;
+    source.frame.cells[2].bg = 0x0100_00eb;
