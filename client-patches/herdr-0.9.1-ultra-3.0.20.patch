+#[test]
+fn stale_or_invalid_status_files_do_not_override_another_theme() {
+    let entries = themes();
+    let mut config = config(entries[0].1, entries[0].2);
+    config.palette.sidebar_bg = Color::Rgb(255, 235, 234);
