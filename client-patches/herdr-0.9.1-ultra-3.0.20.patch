+use super::*;
+use crate::client::shell::sidebar_status::{self, SidebarStatusTheme};
+use ratatui::style::Color;
+
+fn themes() -> [(&'static str, &'static str, &'static str); 3] {
+    [
+        (
+            "blue",
+            include_str!("fixtures/sidebar-blue.toml"),
+            include_str!("fixtures/sidebar-blue.json"),
+        ),
+        (
+            "pink",
+            include_str!("fixtures/sidebar-pink.toml"),
+            include_str!("fixtures/sidebar-pink.json"),
+        ),
+        (
+            "red",
+            include_str!("fixtures/sidebar-red.toml"),
+            include_str!("fixtures/sidebar-red.json"),
+        ),
+    ]
+}
+
+fn config(toml: &str, json: &str) -> ClientShellConfig {
+    let value: Config = toml::from_str(toml).expect("actual plugin config parses");
+    let mut config = ClientShellConfig::from_config(&value);
+    config.sidebar_status =
+        Some(SidebarStatusTheme::from_json(json).expect("plugin status file parses"));
+    config
+}
+
+fn data(status: AgentStatus, selected: bool) -> ClientShellSnapshot {
+    let mut value = snapshot();
+    value.workspaces[0].agent_status = status;
+    value.workspaces[0].focused = selected;
+    value.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("codex".into()),
+        title: None,
+        terminal_title: Some("테마 상태 검사".into()),
+        terminal_title_stripped: Some("테마 상태 검사".into()),
+        agent_status: status,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: vec![
+            ("skyline_group_machine".into(), "[Mac]".into()),
+            ("skyline_group".into(), "theme-project".into()),
+            ("skyline_identity".into(), "검사".into()),
+            ("skyline_branch".into(), "└─".into()),
+            ("skyline_provider".into(), "\u{e1a1} Codex".into()),
+        ],
+        focused: selected,
+    });
+    value
+}
+
+fn contrast(fg: Color, bg: Color) -> f32 {
+    let a = crate::ui::relative_luminance(crate::ui::color_to_rgb(fg).expect("RGB fg"));
+    let b = crate::ui::relative_luminance(crate::ui::color_to_rgb(bg).expect("RGB bg"));
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
+
+#[test]
+fn all_statuses_remain_readable_on_selected_local_and_remote_agent_rows() {
+    let mut proof = Vec::new();
+    for (name, toml, json) in themes() {
+        let config = config(toml, json);
+        for width in [24, 32, 36] {
+            for status in [
+                AgentStatus::Unknown,
+                AgentStatus::Idle,
+                AgentStatus::Working,
+                AgentStatus::Blocked,
+                AgentStatus::Done,
+            ] {
+                for selected in [false, true] {
+                    for machine in [None, Some("SV")] {
+                        let snapshot = data(status, selected);
+                        let row = super::super::agent_sidebar::agent_row(
+                            &snapshot, "pane_1", &config, machine,
+                        )
+                        .expect("agent row");
+                        let rect = Rect::new(0, 0, width, 4);
+                        let mut buffer = Buffer::empty(rect);
+                        buffer.set_style(
+                            rect,
+                            Style::default()
+                                .fg(config.palette.text)
+                                .bg(config.palette.sidebar_bg),
+                        );
+                        super::super::agent_sidebar::render_agent_row(
+                            &mut buffer,
+                            rect,
+                            &row,
+                            &config,
+                        );
+                        sidebar_status::ensure_readable(&mut buffer, rect, &config);
+                        let paint = sidebar_status::paint(&config, status).expect("status style");
+                        assert_eq!(buffer[(0, 0)].symbol(), if selected { "›" } else { "│" });
+                        assert!(
+                            buffer.content.iter().any(|cell| cell.symbol() == paint.icon
+                                && cell.bg == paint.row_background
+                                && cell.fg == paint.icon_foreground),
+                            "{name} {status:?} missing distinct icon"
+                        );
+                        let text = buffer
+                            .content
+                            .iter()
+                            .map(|cell| cell.symbol())
+                            .collect::<String>();
+                        assert!(
+                            text.contains(status_text(status)),
+                            "{name} width={width} {status:?} label truncated: {text}"
+                        );
+                        for cell in &buffer.content {
+                            if cell.symbol().trim().is_empty()
+                                || cell.symbol().chars().any(|c| {
+                                    matches!(c, '\u{e000}'..='\u{f8ff}' | '│' | '─' | '└' | '├')
+                                })
+                            {
+                                continue;
+                            }
+                            if cell.fg == paint.foreground || cell.fg == paint.icon_foreground {
+                                assert!(
+                                    contrast(cell.fg, cell.bg)
+                                        >= if name == "pink" { 3.0 } else { 4.5 }
+                                );
+                                continue;
+                            }
+                            assert!(
+                                contrast(cell.fg, cell.bg) >= 4.5,
+                                "{name} {status:?} selected={selected} {cell:?}"
+                            );
+                        }
+                        assert_eq!(sidebar_status::text_style(&config, status).bg, None);
+                        assert_eq!(sidebar_status::icon_style(&config, status).bg, None);
+                        assert_eq!(
+                            paint.icon_foreground,
+                            sidebar_status_color(status, &config.palette)
+                        );
+                        if width == 32 && machine.is_none() {
+                            proof.push(serde_json::json!({"theme":name,"status":status_text(status),"selected":selected,"width":width,"cells":buffer.content.iter().map(|cell|serde_json::json!({"text":cell.symbol(),"fg":crate::ui::color_to_rgb(cell.fg),"bg":crate::ui::color_to_rgb(cell.bg)})).collect::<Vec<_>>()}));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if let Ok(path) = std::env::var("ULTRA_SIDEBAR_PROOF_PATH") {
+        std::fs::write(path, serde_json::to_vec(&proof).expect("proof JSON"))
+            .expect("save native proof");
+    }
+}
