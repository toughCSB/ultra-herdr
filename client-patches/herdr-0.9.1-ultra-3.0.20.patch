+    state.config.palette.yellow = Color::Rgb(166, 61, 0);
+    state.config.palette.red = Color::Rgb(255, 48, 48);
+    state.config.palette.green = Color::Rgb(0, 107, 60);
+    state.config.palette.teal = Color::Rgb(0, 107, 60);
+    state.config.palette.overlay0 = Color::Rgb(167, 223, 249);
