+pub(crate) fn relative_luminance(color: Rgb) -> f32 {
+    0.2126 * LINEAR[usize::from(color.0)]
+        + 0.7152 * LINEAR[usize::from(color.1)]
+        + 0.0722 * LINEAR[usize::from(color.2)]
+}
+
+pub(crate) fn color_to_rgb(color: Color) -> Option<Rgb> {
+    match color {
+        Color::Reset => None,
+        Color::Black => Some((0, 0, 0)),
+        Color::Red => Some((128, 0, 0)),
+        Color::Green => Some((0, 128, 0)),
+        Color::Yellow => Some((128, 128, 0)),
+        Color::Blue => Some((0, 0, 128)),
+        Color::Magenta => Some((128, 0, 128)),
+        Color::Cyan => Some((0, 128, 128)),
+        Color::Gray => Some((192, 192, 192)),
+        Color::DarkGray => Some((128, 128, 128)),
+        Color::LightRed => Some((255, 0, 0)),
+        Color::LightGreen => Some((0, 255, 0)),
+        Color::LightYellow => Some((255, 255, 0)),
+        Color::LightBlue => Some((0, 0, 255)),
+        Color::LightMagenta => Some((255, 0, 255)),
+        Color::LightCyan => Some((0, 255, 255)),
+        Color::White => Some((255, 255, 255)),
+        Color::Rgb(r, g, b) => Some((r, g, b)),
+        Color::Indexed(index) => Some(match index {
+            0..=15 => [
+                (0, 0, 0), (128, 0, 0), (0, 128, 0), (128, 128, 0),
+                (0, 0, 128), (128, 0, 128), (0, 128, 128), (192, 192, 192),
+                (128, 128, 128), (255, 0, 0), (0, 255, 0), (255, 255, 0),
+                (0, 0, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
+            ][usize::from(index)],
+            16..=231 => {
+                let value = index - 16;
+                let channel = |value| if value == 0 { 0 } else { 55 + 40 * value };
+                (channel(value / 36), channel(value / 6 % 6), channel(value % 6))
+            }
+            232..=255 => {
+                let value = 8 + 10 * (index - 232);
+                (value, value, value)
+            }
+        }),
+    }
+}
+
+pub(crate) fn readable_foreground(foreground: Rgb, background: Rgb, palette: &[u32; 9]) -> Rgb {
+    let background_luminance = relative_luminance(background);
+    let contrast = |color| {
+        let foreground_luminance = relative_luminance(color);
+        (foreground_luminance.max(background_luminance) + 0.05)
+            / (foreground_luminance.min(background_luminance) + 0.05)
+    };
+    // A small margin keeps encoded, rounded RGB above the 4.5:1 target.
+    if contrast(foreground) >= 4.6 {
+        return foreground;
+    }
+    let (r, g, b) = foreground;
+    let max = r.max(g).max(b);
+    let min = r.min(g).min(b);
+    let index = if max - min < 24 {
+        7
+    } else {
+        let span = f32::from(max - min);
+        let hue = if max == r {
+            (f32::from(g) - f32::from(b)) / span
+        } else if max == g {
+            2.0 + (f32::from(b) - f32::from(r)) / span
+        } else {
+            4.0 + (f32::from(r) - f32::from(g)) / span
+        };
+        let hue = if hue < 0.0 { hue + 6.0 } else { hue };
+        if hue < 1.0 / 3.0 || hue >= 5.75 {
+            1
+        } else if hue < 1.25 {
+            3
+        } else if hue < 31.0 / 12.0 {
+            2
+        } else if hue < 41.0 / 12.0 {
+            6
+        } else if hue < 4.5 {
+            4
+        } else if hue < 5.25 {
+            5
+        } else {
+            8
+        }
+    };
+    let [_, r, g, b] = palette[index].to_be_bytes();
+    let base = (r, g, b);
+    if contrast(base) >= 4.6 {
+        return base;
+    }
+    let target = if background_luminance + 0.05 >= 1.05 * 0.05 / (background_luminance + 0.05) {
+        0
+    } else {
+        255
+    };
+    let mix = |amount: u16| {
+        let channel = |value| {
+            // Complementary byte weights keep this quotient in 0..=255.
+            let value = (u16::from(value) * (255 - amount) + target * amount) / 255;
+            value.to_le_bytes()[0]
+        };
+        (channel(r), channel(g), channel(b))
+    };
+    let mut low = 0;
+    let mut high = 255;
+    while low < high {
+        let middle = (low + high) / 2;
+        if contrast(mix(middle)) >= 4.6 {
+            high = middle;
+        } else {
+            low = middle + 1;
+        }
+    }
+    mix(low)
+}
