diff --git a/src/client/shell/tests/terminal_user_messages/msi.rs b/src/client/shell/tests/terminal_user_messages/msi.rs
new file mode 100644
index 0000000..6785a06
--- /dev/null
+++ b/src/client/shell/tests/terminal_user_messages/msi.rs
@@ -0,0 +1,123 @@
+use super::*;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Capture {
+    columns: u16,
+    history_rows: Vec<u16>,
+    ansi: String,
+}
+
+#[test]
+fn retained_cjk_spacer_patches_never_turn_a_red_message_gray() {
+    let mut state = state(
+        "codex",
+        THEMES[2],
+        &["› 가가 메시지", "  계속 답변", "", "• assistant"],
+    );
+    let source = state.pane_surface.as_mut().unwrap();
+    for cell in &mut source.frame.cells[..80] {
+        cell.bg = 0x02323234;
+    }
+    let frame = state.compose(106, 24).unwrap();
+    assert_eq!(composed_row(&state, &frame, 0)[0].bg, THEMES[2].0);
+    // Live MSI retained updates reset the covered half of a wide glyph to an
+    // ordinary blank cell (skip=false, bg=0), unlike a fresh full render.
+    let source = state.pane_surface.as_ref().unwrap();
+    let mut rows = Vec::new();
+    for y in 0..2u16 {
+        for x in 0..39u16 {
+            let cell = &source.frame.cells[usize::from(y * 40 + x)];
+            if UnicodeWidthStr::width(cell.symbol.as_str()) == 2 {
+                let mut spacer = source.frame.cells[usize::from(y * 40 + x + 1)].clone();
+                spacer.symbol = " ".into();
+                spacer.bg = 0;
+                spacer.fg = 0;
+                spacer.modifier = 0;
+                spacer.skip = false;
+                rows.push(crate::protocol::PaneSurfacePatchRow {
+                    x: x + 1,
+                    y,
+                    cells: vec![spacer],
+                });
+            }
+        }
+    }
+    assert!(!rows.is_empty());
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: source.boot_id.clone(),
+        projection_revision: source.projection_revision,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows,
+        panes: source.panes.clone(),
+        cursor: None,
+    };
+    assert!(matches!(
+        state.apply_pane_surface_patch(patch),
+        ClientPaneSurfacePatchOutcome::Applied(None)
+    ));
+    for _ in 0..5 {
+        let frame = state.compose(106, 24).unwrap();
+        for y in 0..2 {
+            assert!(
+                composed_row(&state, &frame, y)
+                    .iter()
+                    .all(|cell| (cell.bg, cell.fg) == THEMES[2]),
+                "retained row {y} reverted to gray"
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn msi_live_gray_cards_keep_message_and_padding_colors() {
+    let capture: Capture = serde_json::from_str(include_str!("msi_captures.json")).unwrap();
+    let width = capture.columns;
+    let height = u16::try_from(capture.ansi.lines().count() + 2).unwrap();
+    let pane =
+        crate::pane::PaneRuntime::test_with_screen_bytes(width, height, capture.ansi.as_bytes());
+    let mut terminal =
+        ratatui::Terminal::new(ratatui::backend::TestBackend::new(width, height)).unwrap();
+    let mut source = surface();
+    terminal
+        .draw(|frame| {
+            pane.render(frame, Rect::new(0, 0, width, height), false);
+            source.frame =
+                FrameData::from_ratatui_buffer_with_hyperlinks(frame.buffer_mut(), None, &[]);
+        })
+        .unwrap();
+    source.panes[0].inner_rect = Rect::new(0, 0, width, height).into();
+    source.panes[0].rect = source.panes[0].inner_rect;
+    let original = source.frame.clone();
+    let mut state = state("codex", THEMES[2], &[]);
+    state.set_pane_surface(source);
+    let frame = state.compose(width + 60, height + 12).unwrap();
+    for y in capture.history_rows {
+        assert!(
+            composed_row(&state, &frame, y)
+                .iter()
+                .all(|cell| (cell.bg, cell.fg) == THEMES[2]),
+            "history row {y}"
+        );
+    }
+    for y in [20, 22] {
+        assert!(
+            composed_row(&state, &frame, y)
+                .iter()
+                .all(|cell| cell.bg == THEMES[2].0),
+            "gray card padding row {y}"
+        );
+    }
+    assert_eq!(
+        state.pane_surface.as_ref().unwrap().frame.cells,
+        original.cells
+    );
+    assert!(
+        composed_row(&state, &frame, 74)
+            .iter()
+            .all(|cell| cell.bg != THEMES[2].0),
+        "composer must stay unpainted"
+    );
+}
