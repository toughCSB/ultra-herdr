+        ("ultra_terminal_fg".into(), "#d4d4d4".into()),
+        ("ultra_terminal_bg".into(), "#000000".into()),
+        ("ultra_terminal_palette".into(), "#d4d4d4,#ff9595,#91d99b,#f0d070,#91caff,#c6a7f6,#80dce8,#b8cce0,#f4a0bf".into()),
+    ];
+    let colors = terminal_colors(&snapshot);
+    assert!(colors.unwrap().palette.is_some());
+    for count in [1, 15] {
