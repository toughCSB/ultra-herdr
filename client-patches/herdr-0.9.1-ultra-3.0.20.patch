+use super::*;
+use serde::Deserialize;
+use std::path::Path;
+
+#[derive(Debug, Clone)]
+pub(super) struct SidebarPaint {
+    pub(super) icon: String,
+    pub(super) foreground: ratatui::style::Color,
+    pub(super) icon_foreground: ratatui::style::Color,
+    pub(super) row_background: ratatui::style::Color,
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct SidebarStatusTheme {
+    sidebar_background: ratatui::style::Color,
+    states: [SidebarPaint; 5],
+}
+
+#[derive(Deserialize)]
+struct ThemeFile {
+    version: u32,
+    sidebar_background: String,
+    states: ThemeStates,
+}
+#[derive(Deserialize)]
+struct ThemeStates {
+    unknown: PaintFile,
+    idle: PaintFile,
+    working: PaintFile,
+    done: PaintFile,
+    blocked: PaintFile,
+}
+#[derive(Deserialize)]
+struct PaintFile {
+    icon: String,
+    foreground: String,
+    icon_foreground: String,
+    row_background: String,
+}
+
+fn color(value: &str) -> Result<ratatui::style::Color, String> {
+    terminal_colors::hex_color(value)
+        .map(crate::protocol::u32_to_color)
+        .ok_or_else(|| "sidebar status color must be #RRGGBB".into())
+}
+
+impl PaintFile {
+    fn paint(self) -> Result<SidebarPaint, String> {
+        if self.icon.chars().count() != 1 || UnicodeWidthStr::width(self.icon.as_str()) != 1 {
+            return Err("sidebar status icon must occupy one terminal cell".into());
+        }
+        Ok(SidebarPaint {
+            foreground: color(&self.foreground)?,
+            icon_foreground: color(&self.icon_foreground)?,
+            row_background: color(&self.row_background)?,
+            icon: self.icon,
+        })
+    }
+}
+
+impl SidebarStatusTheme {
+    pub(super) fn from_json(source: &str) -> Result<Self, String> {
+        let file: ThemeFile = serde_json::from_str(source).map_err(|error| error.to_string())?;
+        if file.version != 2 {
+            return Err("unsupported sidebar status theme version".into());
+        }
+        Ok(Self {
+            sidebar_background: color(&file.sidebar_background)?,
+            states: [
+                file.states.unknown.paint()?,
+                file.states.idle.paint()?,
+                file.states.working.paint()?,
+                file.states.done.paint()?,
+                file.states.blocked.paint()?,
+            ],
+        })
+    }
+    fn paint(
+        &self,
+        status: crate::api::schema::AgentStatus,
+        palette: &Palette,
+    ) -> Option<&SidebarPaint> {
+        // Ignore a stale file from a different local theme during a live switch.
+        (self.sidebar_background == palette.sidebar_bg)
+            .then(|| &self.states[usize::from(status_priority(status))])
+    }
+}
+
+// Read during startup/config reload only, never in a pane-scaled render loop.
+pub(super) fn load(config_path: &Path) -> Option<SidebarStatusTheme> {
+    let path = config_path
+        .parent()?
+        .join("plugins/config/local.ultra-herdr/sidebar-status.json");
+    match std::fs::read_to_string(path) {
+        Ok(source) => match SidebarStatusTheme::from_json(&source) {
+            Ok(theme) => Some(theme),
+            Err(error) => {
+                tracing::warn!(%error, "ignoring invalid ultra-herdr sidebar status theme");
+                None
+            }
+        },
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+        Err(error) => {
+            tracing::warn!(%error, "could not load ultra-herdr sidebar status theme");
+            None
+        }
+    }
+}
+
+pub(super) fn paint(
+    config: &ClientShellConfig,
+    status: crate::api::schema::AgentStatus,
+) -> Option<&SidebarPaint> {
+    config
+        .sidebar_status
+        .as_ref()?
+        .paint(status, &config.palette)
+}
+pub(super) fn icon(config: &ClientShellConfig, status: crate::api::schema::AgentStatus) -> &str {
+    paint(config, status).map_or_else(
+        || sidebar_status_icon(status, config.status_indicators, &config.palette),
+        |paint| paint.icon.as_str(),
+    )
+}
+pub(super) fn text_style(
+    config: &ClientShellConfig,
+    status: crate::api::schema::AgentStatus,
+) -> Style {
+    paint(config, status).map_or_else(
+        || Style::default().fg(sidebar_status_color(status, &config.palette)),
+        |paint| {
+            Style::default()
+                .fg(paint.foreground)
+                .add_modifier(Modifier::BOLD)
+                .remove_modifier(Modifier::DIM | Modifier::REVERSED)
+        },
+    )
+}
+pub(super) fn icon_style(
+    config: &ClientShellConfig,
+    status: crate::api::schema::AgentStatus,
+) -> Style {
+    let style = text_style(config, status);
+    paint(config, status).map_or(style, |paint| style.fg(paint.icon_foreground))
+}
+pub(super) fn decorate(
+    buffer: &mut Buffer,
+    rect: Rect,
+    config: &ClientShellConfig,
+    status: crate::api::schema::AgentStatus,
+    selected: bool,
+) {
+    let Some(paint) = paint(config, status) else {
+        return;
+    };
+    if rect.is_empty() {
+        return;
+    }
+    for y in rect.y..rect.bottom() {
+        let active = selected && y == rect.y;
+        buffer[(rect.x, y)]
+            .set_symbol(if active { "›" } else { "│" })
+            .set_style(
+                Style::default()
+                    .fg(if selected {
+                        config.palette.text
+                    } else {
+                        paint.foreground
+                    })
+                    .bg(if selected {
+                        sidebar_active_row_bg(&config.palette)
+                    } else {
+                        paint.row_background
+                    })
+                    .add_modifier(Modifier::BOLD)
+                    .remove_modifier(Modifier::DIM | Modifier::REVERSED),
+            );
+    }
+}
+
+pub(super) fn ensure_readable(buffer: &mut Buffer, rect: Rect, config: &ClientShellConfig) {
+    if paint(config, crate::api::schema::AgentStatus::Unknown).is_none() {
+        return;
+    }
+    let p = &config.palette;
+    let colors = [
+        p.text, p.red, p.green, p.yellow, p.blue, p.mauve, p.teal, p.overlay0, p.accent,
+    ]
+    .map(|color| {
+        crate::ui::color_to_rgb(color).map_or(0, |(r, g, b)| u32::from_be_bytes([2, r, g, b]))
+    });
+    for y in rect.y..rect.bottom() {
+        for x in rect.x..rect.right() {
+            let cell = &mut buffer[(x, y)];
+            let symbol = cell.symbol();
+            // Keep provider logo identity and decorative tree/divider strokes.
+            if symbol.trim().is_empty()
+                || symbol
+                    .chars()
+                    .any(|c| matches!(c, '\u{e000}'..='\u{f8ff}' | '│' | '─' | '└' | '├'))
+            {
+                continue;
+            }
+            if let (Some(fg), Some(bg)) = (
+                crate::ui::color_to_rgb(cell.fg),
+                crate::ui::color_to_rgb(cell.bg),
+            ) {
+                // Preserve the user's original status colors exactly. Other
+                // sidebar text still receives background-aware correction.
+                if config.sidebar_status.as_ref().is_some_and(|theme| {
+                    theme.states.iter().any(|paint| {
+                        cell.bg == paint.row_background
+                            && (cell.fg == paint.foreground || cell.fg == paint.icon_foreground)
+                    })
+                }) {
+                    continue;
+                }
+                let corrected = crate::ui::readable_foreground(fg, bg, &colors);
+                cell.set_fg(ratatui::style::Color::Rgb(
+                    corrected.0,
+                    corrected.1,
+                    corrected.2,
+                ));
+                cell.set_style(Style::default().remove_modifier(Modifier::DIM));
+            }
+        }
+    }
+}
diff --git a/src/client/shell/terminal_colors.rs b/src/client/shell/terminal_colors.rs
new file mode 100644
index 0000000..4d185a8
--- /dev/null
+++ b/src/client/shell/terminal_colors.rs
@@ -0,0 +1,124 @@
+use super::*;
+
+#[derive(Clone, Copy)]
+pub(super) struct TerminalColors {
+    pub(super) foreground: u32,
+    pub(super) background: u32,
+    pub(super) palette: Option<[u32; 9]>,
+}
+
+pub(super) fn hex_color(value: &str) -> Option<u32> {
+    let hex = value.strip_prefix('#').filter(|hex| {
+        hex.len() == 6 && hex.bytes().all(|byte| byte.is_ascii_hexdigit())
+    })?;
+    u32::from_str_radix(hex, 16).ok().map(|rgb| 0x0200_0000 | rgb)
+}
+
+fn parse_palette(value: &str) -> Option<[u32; 9]> {
+    let mut values = value.split(',');
+    let mut colors = [0; 9];
+    for color in &mut colors {
+        *color = hex_color(values.next()?)?;
+    }
+    values.next().is_none().then_some(colors)
+}
+
+pub(super) fn terminal_colors(snapshot: &ClientShellSnapshot) -> Option<TerminalColors> {
+    let workspace = snapshot.workspaces.iter().find(|workspace| {
+        Some(workspace.workspace_id.as_str()) == snapshot.focused_workspace_id.as_deref()
+    })?;
+    let value = |key: &str| {
+        workspace.tokens.iter().find(|(name, _)| name == key).map(|(_, value)| value.as_str())
+    };
+    let foreground = hex_color(value("ultra_terminal_fg")?)?;
+    let background = hex_color(value("ultra_terminal_bg")?)?;
+    let [_, r, g, b] = background.to_be_bytes();
+    let palette = value("ultra_terminal_palette")
+        .and_then(parse_palette)
+        .filter(|palette| {
+            // Reject stale palettes from the opposite theme polarity, but allow
+            // dark endpoints to repair unreadable explicit child-process colors.
+            let [_, fr, fg, fb] = palette[0].to_be_bytes();
+            let a = crate::ui::relative_luminance((fr, fg, fb));
+            let b = crate::ui::relative_luminance((r, g, b));
+            (a.max(b) + 0.05) / (a.min(b) + 0.05) >= 4.5
+        });
+    Some(TerminalColors { foreground, background, palette })
+}
+
+pub(in crate::client) fn terminal_default_colors(snapshot: &ClientShellSnapshot) -> Option<(u32, u32)> {
+    terminal_colors(snapshot).map(|colors| (colors.foreground, colors.background))
+}
+
+pub(super) fn terminal_gray(color: u32) -> Option<u32> {
+    match color {
+        0x0000_0001 | 0x0100_0000 | 0x0100_0010 => Some(0),
+        0x0000_0008 | 0x0100_0007 => Some(192),
+        0x0000_0009 | 0x0100_0008 => Some(128),
+        0x0000_0010 | 0x0100_000f | 0x0100_00e7 => Some(255),
+        0x0100_00e8..=0x0100_00ff => Some(8 + 10 * ((color & 0xff) - 232)),
+        color if color >> 24 == 2 => {
+            let r = (color >> 16) & 0xff;
+            let g = (color >> 8) & 0xff;
+            let b = color & 0xff;
+            (r == g && g == b).then_some(r)
+        }
+        _ => None,
+    }
+}
+
+pub(super) fn apply_terminal_colors(
+    cell: &mut crate::protocol::CellData,
+    colors: Option<TerminalColors>,
+) {
+    let Some(TerminalColors { foreground, background, palette }) = colors else {
+        return;
+    };
+    let light_defaults = ((background >> 16) & 0xff) * 299
+        + ((background >> 8) & 0xff) * 587
+        + (background & 0xff) * 114
+        >= 128_000;
+    if cell.fg == 0 {
+        cell.fg = foreground;
+    }
+    if cell.bg == 0 {
+        cell.bg = background;
+    }
+    if light_defaults {
+        if let Some(gray) = terminal_gray(cell.bg).filter(|gray| *gray < 128) {
+            let scale = 255 - (gray / 2 + 12);
+            let r = ((background >> 16) & 0xff) * scale / 255;
+            let g = ((background >> 8) & 0xff) * scale / 255;
+            let b = (background & 0xff) * scale / 255;
+            cell.bg = 0x0200_0000 | r << 16 | g << 8 | b;
+        }
+        let light_cell = cell.bg >> 24 == 2
+            && ((cell.bg >> 16) & 0xff) * 299
+                + ((cell.bg >> 8) & 0xff) * 587
+                + (cell.bg & 0xff) * 114
+                >= 128_000;
+        if light_cell && terminal_gray(cell.fg).is_some_and(|gray| gray >= 128) {
+            cell.fg = foreground;
+        }
+    }
+    if let Some(palette) = palette {
+        let colors = (
+            crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.fg)),
+            crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.bg)),
+        );
+        if let (Some(mut fg), Some(mut bg)) = colors {
+            let reversed = cell.modifier & Modifier::REVERSED.bits() != 0;
+            if reversed {
+                std::mem::swap(&mut fg, &mut bg);
+            }
+            fg = crate::ui::readable_foreground(fg, bg, &palette);
+            if reversed {
+                std::mem::swap(&mut fg, &mut bg);
+            }
+            cell.fg = u32::from_be_bytes([2, fg.0, fg.1, fg.2]);
+            cell.bg = u32::from_be_bytes([2, bg.0, bg.1, bg.2]);
+        }
+        // SGR dim would fade corrected RGB back into its background.
+        cell.modifier &= !Modifier::DIM.bits();
+    }
+}
