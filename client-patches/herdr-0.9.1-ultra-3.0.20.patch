+    assert_eq!(frame.cells[index].fg, 0x0230_252b);
+    assert_eq!(frame.cells[index].bg, 0x02e0_dbdb);
+    assert_eq!(frame.cells[index + 1].fg, 0x02cc_cccc);
+    assert_eq!(frame.cells[index + 1].bg, 0x0200_3311);
+    assert_eq!(frame.cells[index + 2].fg, 0x0230_252b);
