+    projection.workspaces.push(other);
+    projection.focused_workspace_id = Some("ws_other".into());
+    state.config.palette.panel_bg = ratatui::style::Color::Blue;
+    state.set_snapshot(Box::new(projection));
+    // When composing the pane.
+    let frame = state.compose(106, 24).unwrap();
+    // Then pane ownership wins over focus and viewer chrome.
+    assert!(composed_row(&state, &frame, 0)
+        .iter()
+        .all(|cell| (cell.bg, cell.fg) == THEMES[1]));
+}
+
+#[test]
+fn plain_menu_and_composer_markers_do_not_become_cards() {
+    // Given the same glyph without the history-only DIM attribute.
+    let mut state = state(
+        "codex",
+        THEMES[0],
