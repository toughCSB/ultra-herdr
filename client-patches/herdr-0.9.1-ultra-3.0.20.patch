+#[test]
+fn done_to_idle_clears_the_previous_badge_and_row_highlight() {
+    for (_, toml, json) in themes() {
+        let config = config(toml, json);
+        let mut state = ClientShellState::new(config);
+        let mut value = data(AgentStatus::Working, false);
+        value.focused_pane_id = None;
+        state.set_snapshot(Box::new(value.clone()));
+        value.revision += 1;
+        value.agents[0].agent_status = AgentStatus::Idle;
+        value.agents[0].state_change_seq += 1;
+        state.set_snapshot(Box::new(value.clone()));
+        let done = state.compose(118, 40).expect("done frame");
+        let paint = sidebar_status::paint(&state.config, AgentStatus::Done).expect("done paint");
+        assert!(done.cells.iter().any(
+            |c| c.symbol == "✔" && c.bg == crate::protocol::color_to_u32(paint.row_background)
+        ));
+        // A coherent viewed surface acknowledges this completion; lifecycle
+        // semantics stay owned by the existing endpoint presentation logic.
+        let mut viewed = surface();
+        viewed.projection_revision = value.revision;
+        state.set_pane_surface(viewed);
+        let idle = state.compose(118, 40).expect("idle frame");
+        let paint = sidebar_status::paint(&state.config, AgentStatus::Idle).expect("idle paint");
+        assert!(idle.cells.iter().any(
+            |c| c.symbol == "●" && c.bg == crate::protocol::color_to_u32(paint.row_background)
+        ));
+        assert!(!idle.cells.iter().any(|c| c.symbol == "✔"));
+    }
+}
