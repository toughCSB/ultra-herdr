+        (AgentStatus::Blocked, Color::Rgb(255, 48, 48)),
+        (AgentStatus::Done, Color::Rgb(0, 107, 60)),
+        (AgentStatus::Idle, Color::Rgb(0, 107, 60)),
+        (AgentStatus::Unknown, Color::Rgb(167, 223, 249)),
+    ] {
+        assert_eq!(status_color(status, &state.config.palette), expected);
+    }
+    assert_eq!(
