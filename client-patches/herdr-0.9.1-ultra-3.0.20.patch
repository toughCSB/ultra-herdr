+    for row in 0..5 {
+        assert!(composed_row(&state, &frame, row)
+            .iter()
+            .all(|cell| cell.bg != THEMES[0].0));
+    }
+}
+
+#[test]
+fn colored_diff_and_collapsed_rows_end_history_cards() {
+    for collapsed in [false, true] {
+        // Given history immediately followed by a diff or collapsed-content row.
+        let mut state = state(
+            "codex",
+            THEMES[2],
+            &[
+                "› submitted",
+                if collapsed {
+                    "  … collapsed"
+                } else {
+                    "  + added code"
+                },
