+use super::*;
+
+#[test]
+fn partial_rows_match_fresh_full_frames() {
+    for colors in THEMES {
+        // Given a composed card with two continuation rows.
+        let mut state = state("codex", colors, &["› submitted", "  first", "  second", ""]);
+        state.compose(106, 24).unwrap();
+        // When only a continuation's background changes to a tool/diff background.
+        let source = state.pane_surface.as_ref().unwrap();
+        let mut cell = source.frame.cells[42].clone();
+        cell.bg = 0x02213a2b;
+        let mut pane = source.panes[0].clone();
+        pane.content_revision += 1;
+        let patch = crate::protocol::PaneSurfacePatch {
+            boot_id: source.boot_id.clone(),
+            projection_revision: source.projection_revision,
+            base_surface_revision: 1,
+            surface_revision: 2,
+            rows: vec![crate::protocol::PaneSurfacePatchRow {
+                x: 2,
+                y: 1,
+                cells: vec![cell.clone()],
+            }],
+            panes: vec![pane.clone()],
+            cursor: None,
+        };
+        assert!(matches!(
+            state.apply_pane_surface_patch(patch),
+            ClientPaneSurfacePatchOutcome::Applied(None)
+        ));
+        let patched = state.compose(106, 24).unwrap();
+        let mut fresh = super::state("codex", colors, &["› submitted", "  first", "  second", ""]);
+        let source = fresh.pane_surface.as_mut().unwrap();
+        source.frame.cells[42] = cell;
+        source.panes[0] = pane;
+        source.surface_revision = 2;
+        let full = fresh.compose(106, 24).unwrap();
+        // Then even untouched continuation rows lose stale cards, identical to a full frame.
+        assert_eq!(patched.cells, full.cells);
+        assert_eq!(patched.cursor, full.cursor);
+        assert_ne!(composed_row(&state, &patched, 2)[0].bg, colors.0);
+    }
+}
+
+#[test]
+fn cursor_only_patches_match_fresh_full_frames() {
+    for colors in THEMES {
+        // Given a visible card and a matching independent full-frame fixture.
+        let mut state = state("codex", colors, &["› submitted", "  continuation", ""]);
+        let mut fresh = super::state("codex", colors, &["› submitted", "  continuation", ""]);
+        state.compose(106, 24).unwrap();
+        let cursor = crate::protocol::CursorState {
+            x: 2,
+            y: 0,
+            visible: true,
+            shape: 2,
+        };
+        let source = state.pane_surface.as_ref().unwrap();
+        let patch = crate::protocol::PaneSurfacePatch {
+            boot_id: source.boot_id.clone(),
+            projection_revision: source.projection_revision,
+            base_surface_revision: 1,
+            surface_revision: 2,
+            rows: Vec::new(),
+            panes: Vec::new(),
+            cursor: Some(cursor.clone()),
+        };
+        // When a cursor-only patch arrives.
+        assert!(matches!(
+            state.apply_pane_surface_patch(patch),
+            ClientPaneSurfacePatchOutcome::Applied(None)
+        ));
+        let patched = state.compose(106, 24).unwrap();
+        fresh.pane_surface.as_mut().unwrap().frame.cursor = Some(cursor);
+        let full = fresh.compose(106, 24).unwrap();
+        // Then the composer guard and cursor projection are identical.
+        assert_eq!(patched.cells, full.cells);
+        assert_eq!(patched.cursor, full.cursor);
+        assert_ne!(composed_row(&state, &patched, 0)[0].bg, colors.0);
+    }
+}
+
+#[test]
+fn removing_history_marker_invalidates_unchanged_continuation_rows() {
+    // Given a visible card.
+    let mut state = state("codex", THEMES[0], &["› submitted", "  continuation", ""]);
+    state.compose(106, 24).unwrap();
+    let source = state.pane_surface.as_ref().unwrap();
+    let mut marker = source.frame.cells[0].clone();
+    marker.symbol = "•".into();
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: source.boot_id.clone(),
+        projection_revision: source.projection_revision,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows: vec![crate::protocol::PaneSurfacePatchRow {
+            x: 0,
+            y: 0,
+            cells: vec![marker],
+        }],
+        panes: source.panes.clone(),
+        cursor: None,
+    };
+    // When the history marker disappears.
+    assert!(matches!(
+        state.apply_pane_surface_patch(patch),
+        ClientPaneSurfacePatchOutcome::Applied(None)
+    ));
+    let frame = state.compose(106, 24).unwrap();
+    // Then no unchanged row retains the old card color.
+    for y in 0..2 {
+        assert!(composed_row(&state, &frame, y)
+            .iter()
+            .all(|cell| cell.bg != THEMES[0].0));
+    }
+}
+
+#[test]
+fn adding_history_style_recolors_unchanged_continuation_rows() {
+    // Given a plain marker and an unpainted continuation.
+    let mut state = state("codex", THEMES[2], &["› submitted", "  continuation", ""]);
+    state.pane_surface.as_mut().unwrap().frame.cells[0].modifier = Modifier::BOLD.bits();
+    state.compose(106, 24).unwrap();
+    let source = state.pane_surface.as_ref().unwrap();
+    let mut marker = source.frame.cells[0].clone();
+    marker.modifier |= Modifier::DIM.bits();
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: source.boot_id.clone(),
+        projection_revision: source.projection_revision,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows: vec![crate::protocol::PaneSurfacePatchRow {
+            x: 0,
+            y: 0,
+            cells: vec![marker],
+        }],
+        panes: source.panes.clone(),
+        cursor: None,
+    };
+    // When only the source marker gains the history attribute.
+    assert!(matches!(
+        state.apply_pane_surface_patch(patch),
+        ClientPaneSurfacePatchOutcome::Applied(None)
+    ));
+    let patched = state.compose(106, 24).unwrap();
+    let mut fresh = super::state("codex", THEMES[2], &["› submitted", "  continuation", ""]);
+    let full = fresh.compose(106, 24).unwrap();
+    // Then the unchanged continuation is painted exactly as in a full frame.
+    assert_eq!(patched.cells, full.cells);
+    assert_eq!(
+        (
+            composed_row(&state, &patched, 1)[0].bg,
+            composed_row(&state, &patched, 1)[0].fg
+        ),
+        THEMES[2]
+    );
+}
