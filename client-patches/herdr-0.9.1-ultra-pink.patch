+    assert_eq!(buffer[sidebar_frame].fg, Color::Rgb(72, 13, 48));
+    let workspace = state.hits.workspaces.first().unwrap().rect;
+    let workspace_icon = cell_symbol_position(&frame, workspace, "●");
+    assert_eq!(buffer[workspace_icon].fg, Color::Rgb(166, 61, 0));
+    let workspace_cell = cell_symbol_position(&frame, workspace, "client-shell");
+    assert_eq!(buffer[workspace_cell].fg, Color::Rgb(72, 13, 48));
+
+    let pink_sidebar_bg = state.config.palette.sidebar_bg;
+    let pink_active_row_bg = state.config.palette.active_row_bg;
+    for (sidebar_bg, active_row_bg) in [
+        (Color::Rgb(29, 66, 99), Color::Rgb(57, 119, 170)),
+        (Color::Rgb(38, 38, 43), Color::Rgb(200, 29, 37)),
+    ] {
+        state.config.palette.sidebar_bg = sidebar_bg;
+        state.config.palette.active_row_bg = active_row_bg;
+        assert_eq!(
+            sidebar_status_color(AgentStatus::Working, &state.config.palette),
+            state.config.palette.yellow,
+        );
+    }
+    state.config.palette.sidebar_bg = pink_sidebar_bg;
+    state.config.palette.active_row_bg = pink_active_row_bg;
+
+    projected.focused_pane_id = Some("pane_2".into());
+    for pane in &mut projected.panes {
+        pane.focused = pane.pane_id == "pane_2";
+    }
+    for agent in &mut projected.agents {
+        agent.focused = agent.pane_id == "pane_2";
+    }
+    state.set_snapshot(Box::new(projected.clone()));
+    let switched = state.compose(160, 30).expect("changed focus frame");
+    let buffer = switched.to_ratatui_buffer().expect("changed focus buffer");
+    assert_eq!(buffer[first_cell].fg, Color::Rgb(217, 119, 87));
+    assert_eq!(buffer[second_icon].bg, Color::Rgb(254, 186, 185));
+
+    for (status, label) in [(AgentStatus::Done, "done"), (AgentStatus::Idle, "idle")] {
+        state.outer_focused = Some(status == AgentStatus::Idle);
+        for agent in &mut projected.agents {
+            agent.agent_status = status;
+            agent.state_change_seq += 1;
+        }
+        state.set_snapshot(Box::new(projected.clone()));
+        let frame = state.compose(160, 30).expect("green status frame");
+        let buffer = frame.to_ratatui_buffer().expect("green status buffer");
+        let row = state.hits.agents.iter().find(|(_, id)| id == "pane_1").unwrap().0;
+        let icon = cell_symbol_position(&frame, row, "●");
+        let text = cell_symbol_position(&frame, row, label);
+        assert_eq!(buffer[icon].fg, Color::Rgb(0, 107, 60));
+        assert_eq!(buffer[text].fg, Color::Rgb(0, 107, 60));
+    }
+}
