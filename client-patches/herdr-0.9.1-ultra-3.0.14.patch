 impl ClientShellState {
+    pub(crate) fn endpoint_terminal_colors(
+        &self,
+        endpoint_id: &ClientEndpointId,
+    ) -> Option<(u32, u32)> {
+        self.endpoints
+            .iter()
+            .find(|endpoint| &endpoint.endpoint_id == endpoint_id)
+            .and_then(|endpoint| endpoint.snapshot.as_deref())
+            .and_then(terminal_default_colors)
+    }
+
+    pub(crate) fn endpoint_host_theme_update(
+        &self,
+        endpoint_id: &ClientEndpointId,
+        update: &crate::protocol::ClientHostThemeUpdate,
+    ) -> Option<crate::protocol::ClientHostThemeUpdate> {
+        use crate::protocol::{
+            ClientHostAppearance, ClientHostColor, ClientHostDefaultColorKind,
+            ClientHostThemeUpdate,
+        };
+        if matches!(update, ClientHostThemeUpdate::PaletteColors(_)) && !endpoint_id.is_local() {
+            return None;
+        }
+        let colors = self.endpoint_terminal_colors(endpoint_id);
+        let Some((foreground, background)) = colors else {
+            return Some(update.clone());
+        };
+        let host_color = |color: u32| ClientHostColor {
+            r: ((color >> 16) & 0xff) as u8,
+            g: ((color >> 8) & 0xff) as u8,
+            b: (color & 0xff) as u8,
+        };
+        Some(match update {
+            ClientHostThemeUpdate::DefaultColor { kind, .. } => {
+                ClientHostThemeUpdate::DefaultColor {
+                    kind: *kind,
+                    color: host_color(match kind {
+                        ClientHostDefaultColorKind::Foreground => foreground,
+                        ClientHostDefaultColorKind::Background => background,
+                    }),
+                }
+            }
+            ClientHostThemeUpdate::Appearance(_) => {
+                let appearance = crate::terminal_theme::RgbColor::from(host_color(background))
+                    .inferred_appearance();
+                ClientHostThemeUpdate::Appearance(match appearance {
+                    crate::terminal_theme::HostAppearance::Dark => ClientHostAppearance::Dark,
+                    crate::terminal_theme::HostAppearance::Light => ClientHostAppearance::Light,
+                })
+            }
+            ClientHostThemeUpdate::PaletteColors(_) => update.clone(),
+        })
+    }
+
