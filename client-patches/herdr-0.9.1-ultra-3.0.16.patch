index 0000000..e1a01ee
--- /dev/null
+++ b/src/client/shell/tests/terminal_user_messages/ownership.rs
@@ -0,0 +1,93 @@
+use super::*;
+
+#[test]
+fn selection_overrides_cards_without_mutating_source() {
+    // Given a rendered user card.
+    let mut state = state("codex", THEMES[0], &["› submitted", "  continuation", ""]);
+    state.compose(106, 24).unwrap();
+    let original = state.pane_surface.as_ref().unwrap().frame.clone();
+    let pane = state.hits.panes[0].clone();
+    // When the client selects text in that card.
+    for (kind, column) in [
+        (MouseEventKind::Down(MouseButton::Left), pane.inner_rect.x),
+        (
+            MouseEventKind::Drag(MouseButton::Left),
+            pane.inner_rect.x + 3,
+        ),
+    ] {
+        state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind,
+            column,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+    }
+    let frame = state.compose(106, 24).unwrap();
+    // Then selection colors win, while unselected card cells and source data remain intact.
+    let row = composed_row(&state, &frame, 0);
+    assert_eq!((row[1].bg, row[1].fg), (0x029b235f, 0x02ffffff));
+    assert_eq!((row[10].bg, row[10].fg), THEMES[0]);
+    assert_eq!(
+        state.pane_surface.as_ref().unwrap().frame.cells,
+        original.cells
+    );
+}
+
+#[test]
+fn missing_or_invalid_tokens_do_not_enable_message_cards() {
+    for value in [None, Some("#oops"), Some("#1234567"), Some("#+12345")] {
+        // Given an incomplete or invalid plugin token pair.
+        let mut state = state("codex", THEMES[0], &["› submitted", ""]);
+        let mut projection = state.snapshot.as_deref().unwrap().clone();
+        projection.workspaces[0]
+            .tokens
+            .retain(|(key, _)| key != "ultra_user_message_fg");
+        if let Some(value) = value {
+            projection.workspaces[0]
+                .tokens
+                .push(("ultra_user_message_fg".into(), value.into()));
+        }
+        state.set_snapshot(Box::new(projection));
+        // When composing.
+        let frame = state.compose(106, 24).unwrap();
+        // Then source rendering is preserved rather than substituting a host-theme fallback.
+        assert!(composed_row(&state, &frame, 0)
+            .iter()
+            .all(|cell| cell.bg != THEMES[0].0));
+    }
+}
+
+#[test]
+fn display_label_does_not_override_detected_agent_ownership() {
+    // Given Pi renamed to Codex for display.
+    let mut state = state("pi", THEMES[0], &["› submitted", ""]);
+    let mut projection = state.snapshot.as_deref().unwrap().clone();
+    projection.agents[0].display_agent = Some("codex".into());
+    state.set_snapshot(Box::new(projection));
+    // When composing.
+    let frame = state.compose(106, 24).unwrap();
+    // Then Pi's source remains outside the recognizer.
+    assert_ne!(composed_row(&state, &frame, 0)[0].bg, THEMES[0].0);
+}
+
+#[test]
+fn styled_hyperlinks_keep_targets_and_underlines_inside_cards() {
+    // Given a real link style inside a plain user message.
+    let mut state = state("codex", THEMES[0], &["› link example", ""]);
+    let source = state.pane_surface.as_mut().unwrap();
+    source.frame.hyperlinks.push("https://example.test".into());
+    for cell in &mut source.frame.cells[7..14] {
+        cell.fg = 0x020000ff;
+        cell.modifier = Modifier::UNDERLINED.bits();
+        cell.hyperlink = Some(0);
+    }
+    // When composing the card after generic contrast correction.
+    let frame = state.compose(106, 24).unwrap();
+    // Then the link gets readable card colors but retains its target and underline.
+    for cell in &composed_row(&state, &frame, 0)[7..14] {
+        assert_eq!((cell.bg, cell.fg), THEMES[0]);
+        assert_eq!(cell.hyperlink, Some(0));
+        assert_ne!(cell.modifier & Modifier::UNDERLINED.bits(), 0);
+    }
+    assert_eq!(frame.hyperlinks, ["https://example.test"]);
+}
