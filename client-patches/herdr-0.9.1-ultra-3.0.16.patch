@@ -0,0 +1,171 @@
+use super::*;
+
+const LIGHT_PALETTE: &str =
+    "#30252b,#b42318,#146b3a,#8a4b00,#244da8,#74338f,#006a73,#68505c,#9b235f";
+
+fn themed_state(foreground: u32, background: u32, light: bool) -> ClientShellState {
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.palette.panel_bg = ratatui::style::Color::Rgb(11, 11, 14);
+    config.palette.selection_bg = ratatui::style::Color::Rgb(200, 29, 37);
+    let mut state = ClientShellState::new(config);
+    let mut value = snapshot();
+    value.workspaces[0].tokens = vec![
+        ("ultra_terminal_fg".into(), if light { "#30252b" } else { "#d4d4d4" }.into()),
+        ("ultra_terminal_bg".into(), if light { "#fffafa" } else { "#0b0b0e" }.into()),
+        ("ultra_terminal_palette".into(), LIGHT_PALETTE.into()),
+    ];
+    state.set_snapshot(Box::new(value));
+    let mut value = surface();
+    value.frame.cells[0].fg = foreground;
+    value.frame.cells[0].bg = background;
+    value.frame.cells[0].modifier = Modifier::DIM.bits();
+    state.set_pane_surface(value);
+    state
+}
+
+fn luminance(color: u32) -> f64 {
+    let [_, r, g, b] = color.to_be_bytes();
+    let channel = |value| {
+        let value = f64::from(value) / 255.0;
+        if value <= 0.04045 { value / 12.92 } else { ((value + 0.055) / 1.055).powf(2.4) }
+    };
+    0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)
+}
+
+#[test]
+fn light_terminal_colored_text_has_readable_contrast() {
+    for foreground in [
+        0x02ffff00, 0x0299ccff, 0x0299ee99, 0x02ffbbbb, 0x02d6aaff, 0x0280dce8,
+    ] {
+        for background in [0, 0x02262626, 0x02fff0f3, 0x02d97757] {
+            let mut state = themed_state(foreground, background, true);
+            let frame = state.compose(106, 20).expect("frame");
+            let pane = &state.hits.panes[0];
+            let cell = &frame.cells[
+                usize::from(pane.inner_rect.y) * usize::from(frame.width)
+                    + usize::from(pane.inner_rect.x)
+            ];
+            let foreground = luminance(cell.fg);
+            let background = luminance(cell.bg);
+            let contrast = (foreground.max(background) + 0.05) / (foreground.min(background) + 0.05);
+            assert!(contrast >= 4.5, "{contrast}: {cell:?}");
+        }
+    }
+}
+
+#[test]
+fn light_terminal_dim_text_is_not_faded_again() {
+    let mut state = themed_state(0x02705d67, 0, true);
+    let frame = state.compose(106, 20).expect("frame");
+    let pane = &state.hits.panes[0];
+    let cell = &frame.cells[
+        usize::from(pane.inner_rect.y) * usize::from(frame.width)
+            + usize::from(pane.inner_rect.x)
+    ];
+    assert_eq!(cell.modifier & Modifier::DIM.bits(), 0);
+}
+
+#[test]
+fn dark_terminal_keeps_its_colors_and_dim_text_with_stale_light_metadata() {
+    let mut state = themed_state(0x02ffff00, 0x020b0b0e, false);
+    let frame = state.compose(106, 20).expect("frame");
+    let pane = &state.hits.panes[0];
+    let cell = &frame.cells[
+        usize::from(pane.inner_rect.y) * usize::from(frame.width)
+            + usize::from(pane.inner_rect.x)
+    ];
+    assert_eq!(cell.fg, 0x02ffff00);
+    assert_eq!(cell.bg, 0x020b0b0e);
+    assert_ne!(cell.modifier & Modifier::DIM.bits(), 0);
+}
+
+#[test]
+fn light_endpoint_selection_is_pink_and_white_even_in_a_dark_viewer() {
+    let mut state = themed_state(0x02ffff00, 0, true);
+    state.compose(106, 20).expect("frame");
+    let pane = state.hits.panes[0].clone();
+    for (kind, column) in [
+        (MouseEventKind::Down(MouseButton::Left), pane.inner_rect.x),
+        (MouseEventKind::Drag(MouseButton::Left), pane.inner_rect.x + 2),
+    ] {
+        state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind, column, row: pane.inner_rect.y, modifiers: KeyModifiers::empty(),
+        })]);
+    }
+    let frame = state.compose(106, 20).expect("selected frame");
+    let cell = &frame.cells[
+        usize::from(pane.inner_rect.y) * usize::from(frame.width)
