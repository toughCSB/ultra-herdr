+                "\x1b[48;2;65;69;76m  wrapped input\x1b[0m\r\n\r\n",
+                "\x1b[48;2;33;58;43m  + diff output\x1b[0m\r\n\r\n",
+                "\x1b[1m\x1b[48;2;65;69;76m› \x1b[0m",
+                "\x1b[2m\x1b[48;2;65;69;76mdraft\x1b[0m",
+            ),
+        ),
+        (
+            "claude",
+            concat!(
+                "\x1b[0m\x1b[38;2;153;153;153m\x1b[48;2;55;55;55m❯ 질문 漢字\x1b[0m\r\n",
+                "\x1b[0m\x1b[38;2;153;153;153m\x1b[48;2;55;55;55m  wrapped input\x1b[0m\r\n\r\n",
+                "\x1b[0m⏺ tool output\r\n\r\n",
+                "\x1b[0m❯\u{a0}draft\x1b[0m",
+            ),
+        ),
+    ];
+    for (agent, ansi) in captures {
+        for colors in THEMES {
+            let pane = crate::pane::PaneRuntime::test_with_screen_bytes(40, 12, ansi.as_bytes());
+            let backend = ratatui::backend::TestBackend::new(40, 12);
+            let mut terminal = ratatui::Terminal::new(backend).unwrap();
+            let mut source = surface();
+            terminal
+                .draw(|frame| {
+                    pane.render(frame, Rect::new(0, 0, 40, 12), false);
+                    source.frame = FrameData::from_ratatui_buffer_with_hyperlinks(
+                        frame.buffer_mut(),
+                        None,
+                        &[],
+                    );
+                })
+                .unwrap();
+            source.panes[0].rect = Rect::new(0, 0, 40, 12).into();
+            source.panes[0].inner_rect = source.panes[0].rect;
+            let raw = source.frame.clone();
+            let mut state = state(agent, colors, &[]);
+            state.set_pane_surface(source);
+            // When the native shell composes cells emitted by the real ANSI parser/renderer.
+            let frame = state.compose(106, 24).unwrap();
+            // Then only message rows gain cards; application text and other styles survive.
+            for y in 0..12 {
+                for (x, cell) in composed_row(&state, &frame, y).iter().enumerate() {
+                    let source = &raw.cells[usize::from(y) * 40 + x];
+                    assert_eq!((&cell.symbol, cell.skip), (&source.symbol, source.skip));
+                    if y < 2 {
+                        assert_eq!((cell.bg, cell.fg), colors, "{agent} row {y} column {x}");
+                    } else {
+                        let mut expected = source.clone();
+                        apply_terminal_colors(
+                            &mut expected,
+                            terminal_colors(state.snapshot.as_deref().unwrap()),
+                        );
+                        assert_eq!(cell, &expected, "{agent} row {y} column {x}");
+                    }
+                }
+            }
+        }
+    }
+}
