+                "\x1b[0m\x1b[1m\x1b[2m› \x1b[0m질문 漢字\r\n",
+                "\x1b[0m  wrapped input\r\n\r\n",
+                "\x1b[0m\x1b[48;2;33;58;43m  + diff output\x1b[0m\r\n\r\n",
+                "\x1b[0m\x1b[1m› \x1b[0m\x1b[2mdraft\x1b[0m",
+            ),
+        ),
