-fn status_dot(status: crate::api::schema::AgentStatus) -> &'static str {
-    status_icon(status, crate::config::StatusIndicatorStyle::Dots)
+fn sidebar_status_icon(
+    status: crate::api::schema::AgentStatus,
+    style: crate::config::StatusIndicatorStyle,
+    palette: &Palette,
+) -> &'static str {
+    if is_ultra_herdr_pink(palette) {
+        "●"
+    } else {
+        status_icon(status, style)
+    }
+}
+
+fn is_ultra_herdr_pink(palette: &Palette) -> bool {
+    palette.sidebar_bg == ratatui::style::Color::Rgb(255, 235, 234)
+}
+
+fn sidebar_active_row_bg(palette: &Palette) -> ratatui::style::Color {
+    if is_ultra_herdr_pink(palette) {
+        ratatui::style::Color::Rgb(254, 186, 185)
+    } else {
+        palette.active_row_bg
+    }
+}
+
+fn sidebar_selection_bg(palette: &Palette) -> ratatui::style::Color {
+    if is_ultra_herdr_pink(palette) {
+        ratatui::style::Color::Rgb(254, 186, 185)
+    } else if palette.selection_bg == ratatui::style::Color::Reset {
+        palette.active_row_bg
+    } else {
+        palette.selection_bg
+    }
+}
+
+fn sidebar_status_color(
+    status: crate::api::schema::AgentStatus,
+    palette: &Palette,
+) -> ratatui::style::Color {
+    if is_ultra_herdr_pink(palette) && status == crate::api::schema::AgentStatus::Working {
+        palette.yellow
+    } else {
+        status_color(status, palette)
+    }
 }
 
