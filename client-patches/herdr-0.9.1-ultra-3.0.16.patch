new file mode 100644
index 0000000..3e867f0
--- /dev/null
+++ b/src/client/shell/terminal_colors.rs
@@ -0,0 +1,117 @@
+use super::*;
+
+#[derive(Clone, Copy)]
+pub(super) struct TerminalColors {
+    pub(super) foreground: u32,
+    pub(super) background: u32,
+    pub(super) palette: Option<[u32; 9]>,
+}
+
+pub(super) fn hex_color(value: &str) -> Option<u32> {
+    let hex = value.strip_prefix('#').filter(|hex| {
+        hex.len() == 6 && hex.bytes().all(|byte| byte.is_ascii_hexdigit())
+    })?;
+    u32::from_str_radix(hex, 16).ok().map(|rgb| 0x0200_0000 | rgb)
+}
+
+fn parse_palette(value: &str) -> Option<[u32; 9]> {
+    let mut values = value.split(',');
+    let mut colors = [0; 9];
+    for color in &mut colors {
+        *color = hex_color(values.next()?)?;
+    }
+    values.next().is_none().then_some(colors)
+}
+
+pub(super) fn terminal_colors(snapshot: &ClientShellSnapshot) -> Option<TerminalColors> {
+    let workspace = snapshot.workspaces.iter().find(|workspace| {
+        Some(workspace.workspace_id.as_str()) == snapshot.focused_workspace_id.as_deref()
+    })?;
+    let value = |key: &str| {
+        workspace.tokens.iter().find(|(name, _)| name == key).map(|(_, value)| value.as_str())
+    };
+    let foreground = hex_color(value("ultra_terminal_fg")?)?;
+    let background = hex_color(value("ultra_terminal_bg")?)?;
+    let [_, r, g, b] = background.to_be_bytes();
+    let palette = value("ultra_terminal_palette")
+        .and_then(parse_palette)
+        .filter(|_| crate::ui::relative_luminance((r, g, b)) >= 0.5);
+    Some(TerminalColors { foreground, background, palette })
+}
+
+pub(in crate::client) fn terminal_default_colors(snapshot: &ClientShellSnapshot) -> Option<(u32, u32)> {
+    terminal_colors(snapshot).map(|colors| (colors.foreground, colors.background))
+}
+
+pub(super) fn terminal_gray(color: u32) -> Option<u32> {
+    match color {
+        0x0000_0001 | 0x0100_0000 | 0x0100_0010 => Some(0),
+        0x0000_0008 | 0x0100_0007 => Some(192),
+        0x0000_0009 | 0x0100_0008 => Some(128),
+        0x0000_0010 | 0x0100_000f | 0x0100_00e7 => Some(255),
+        0x0100_00e8..=0x0100_00ff => Some(8 + 10 * ((color & 0xff) - 232)),
+        color if color >> 24 == 2 => {
+            let r = (color >> 16) & 0xff;
+            let g = (color >> 8) & 0xff;
+            let b = color & 0xff;
+            (r == g && g == b).then_some(r)
+        }
+        _ => None,
+    }
+}
+
+pub(super) fn apply_terminal_colors(
+    cell: &mut crate::protocol::CellData,
+    colors: Option<TerminalColors>,
+) {
+    let Some(TerminalColors { foreground, background, palette }) = colors else {
+        return;
+    };
+    let light_defaults = ((background >> 16) & 0xff) * 299
+        + ((background >> 8) & 0xff) * 587
+        + (background & 0xff) * 114
+        >= 128_000;
+    if cell.fg == 0 {
+        cell.fg = foreground;
+    }
+    if cell.bg == 0 {
+        cell.bg = background;
+    }
+    if light_defaults {
+        if let Some(gray) = terminal_gray(cell.bg).filter(|gray| *gray < 128) {
+            let scale = 255 - (gray / 2 + 12);
+            let r = ((background >> 16) & 0xff) * scale / 255;
+            let g = ((background >> 8) & 0xff) * scale / 255;
+            let b = (background & 0xff) * scale / 255;
+            cell.bg = 0x0200_0000 | r << 16 | g << 8 | b;
+        }
+        let light_cell = cell.bg >> 24 == 2
+            && ((cell.bg >> 16) & 0xff) * 299
+                + ((cell.bg >> 8) & 0xff) * 587
+                + (cell.bg & 0xff) * 114
+                >= 128_000;
+        if light_cell && terminal_gray(cell.fg).is_some_and(|gray| gray >= 128) {
+            cell.fg = foreground;
+        }
+    }
+    if let Some(palette) = palette {
+        let colors = (
+            crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.fg)),
+            crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.bg)),
+        );
+        if let (Some(mut fg), Some(mut bg)) = colors {
+            let reversed = cell.modifier & Modifier::REVERSED.bits() != 0;
+            if reversed {
+                std::mem::swap(&mut fg, &mut bg);
+            }
+            fg = crate::ui::readable_foreground(fg, bg, &palette);
+            if reversed {
+                std::mem::swap(&mut fg, &mut bg);
+            }
+            cell.fg = u32::from_be_bytes([2, fg.0, fg.1, fg.2]);
+            cell.bg = u32::from_be_bytes([2, bg.0, bg.1, bg.2]);
+        }
+        // SGR dim would fade readable RGB back into the light background.
+        cell.modifier &= !Modifier::DIM.bits();
+    }
+}
