@@ -0,0 +1,78 @@
+use super::*;
+
+#[test]
+fn fixed_geometry_uses_each_panes_workspace_at_one_and_fifteen_panes() {
+    for count in [1_u16, 15] {
+        // Given fixed 40x180 geometry, with one or fifteen independently owned panes.
+        let state = state("codex", THEMES[0], &["› submitted", "  continuation", ""]);
+        let mut snapshot = state.snapshot.as_deref().unwrap().clone();
+        let mut surface = state.pane_surface.as_ref().unwrap().clone();
+        let source_cells = surface.frame.cells.clone();
+        surface.frame.height = 180;
+        surface.frame.cells.clear();
+        for _ in 0..15 {
+            surface.frame.cells.extend(source_cells.iter().cloned());
+        }
+        let pane = surface.panes[0].clone();
+        let owner = snapshot.panes[0].clone();
+        let agent = snapshot.agents[0].clone();
+        let workspace = snapshot.workspaces[0].clone();
+        surface.panes.clear();
+        snapshot.panes.clear();
+        snapshot.agents.clear();
+        snapshot.workspaces.clear();
+        for index in 0..count {
+            let pane_id = format!("pane_{index}");
+            let workspace_id = format!("ws_{index}");
+            let colors = THEMES[usize::from(index) % THEMES.len()];
+            let mut pane = pane.clone();
+            pane.pane_id = pane_id.clone();
+            pane.inner_rect.y = index * 12;
+            pane.rect = pane.inner_rect;
+            surface.panes.push(pane);
+            let mut owner = owner.clone();
+            owner.pane_id = pane_id.clone();
+            owner.workspace_id = workspace_id.clone();
+            snapshot.panes.push(owner);
+            let mut agent = agent.clone();
+            agent.pane_id = pane_id;
+            agent.workspace_id = workspace_id.clone();
+            snapshot.agents.push(agent);
+            let mut workspace = workspace.clone();
+            workspace.workspace_id = workspace_id;
+            workspace.tokens = vec![
+                (
+                    "ultra_user_message_bg".into(),
+                    format!("#{:06x}", colors.0 & 0xffffff),
+                ),
+                (
+                    "ultra_user_message_fg".into(),
+                    format!("#{:06x}", colors.1 & 0xffffff),
+                ),
+            ];
+            snapshot.workspaces.push(workspace);
+        }
+        let cards = super::super::super::user_messages::UserMessageCards {
+            snapshot: &snapshot,
+            surface: &surface,
+        };
+        let mut target = surface.frame.clone();
+        // When rendering repeatedly for a supporting headless scaling profile.
+        let started = std::time::Instant::now();
+        for _ in 0..100 {
+            cards.render(std::hint::black_box(&mut target), Rect::new(0, 0, 40, 180));
+        }
+        eprintln!(
+            "user message overlay: {count} panes, 100 renders, {:?}",
+            started.elapsed()
+        );
+        // Then each pane has its own theme, independent of cardinality. No timing assertion.
+        for index in 0..count {
+            let cell = &target.cells[usize::from(index) * 12 * 40];
+            assert_eq!(
+                (cell.bg, cell.fg),
+                THEMES[usize::from(index) % THEMES.len()]
+            );
+        }
+    }
+}
diff --git a/src/client/shell/user_messages.rs b/src/client/shell/user_messages.rs
new file mode 100644
index 0000000..90b23b9
--- /dev/null
+++ b/src/client/shell/user_messages.rs
@@ -0,0 +1,278 @@
+use super::*;
+use crate::protocol::{CellData, PaneSurfacePane};
+
+#[derive(Clone, Copy)]
+enum Agent {
+    Codex,
+    Claude,
+}
+
+#[derive(Clone, Copy)]
+struct Card {
+    agent: Agent,
+    foreground: u32,
+    background: u32,
+}
+
+/// Presentation only: recognition always reads the unmodified source cells.
+pub(super) struct UserMessageCards<'a> {
+    pub(super) snapshot: &'a ClientShellSnapshot,
+    pub(super) surface: &'a PaneSurfaceFrame,
+}
+
+impl UserMessageCards<'_> {
+    fn card(&self, pane: &PaneSurfacePane) -> Option<Card> {
+        let agent = self
+            .snapshot
+            .agents
+            .iter()
+            .find(|agent| agent.pane_id == pane.pane_id)?;
+        // The detected executable, not a user-editable display label, owns the grammar.
+        let agent = match agent.agent.as_deref()? {
+            "codex" => Agent::Codex,
+            "claude" | "claude-code" => Agent::Claude,
+            _ => return None,
+        };
+        let owner = self
+            .snapshot
+            .panes
+            .iter()
+            .find(|owner| owner.pane_id == pane.pane_id)?;
+        let workspace = self
+            .snapshot
+            .workspaces
+            .iter()
+            .find(|workspace| workspace.workspace_id == owner.workspace_id)?;
+        let color = |key| {
+            workspace
+                .tokens
+                .iter()
+                .find(|(name, _)| name == key)
+                .and_then(|(_, value)| terminal_colors::hex_color(value))
+        };
+        Some(Card {
+            agent,
+            foreground: color("ultra_user_message_fg")?,
+            background: color("ultra_user_message_bg")?,
+        })
+    }
+
+    pub(super) fn enabled(&self) -> bool {
+        self.surface
+            .panes
+            .iter()
+            .any(|pane| self.card(pane).is_some())
+    }
+
+    pub(super) fn render(&self, target: &mut FrameData, area: Rect) {
+        for pane in &self.surface.panes {
+            let Some(card) = self.card(pane) else {
+                continue;
+            };
+            let source = PaneRows {
+                frame: &self.surface.frame,
+                pane,
+            };
+            let mut row = 0;
+            while row < pane.inner_rect.height {
+                let Some(end) = source.message_end(row, card.agent) else {
+                    row += 1;
+                    continue;
+                };
+                let background = source.row(row).first().map_or(0, |cell| cell.bg);
+                let mut start = row;
+                while start > 0
+                    && background != 0
+                    && !source.cursor_on(start - 1)
+                    && blank(source.row(start - 1))
+                    && solid_background(source.row(start - 1), background)
+                {
+                    start -= 1;
+                }
+                for y in start..end {
+                    let source_y = pane.inner_rect.y.saturating_add(y);
+                    if source_y >= area.height {
+                        break;
+                    }
+                    for x in pane.inner_rect.x
+                        ..pane
+                            .inner_rect
+                            .x
+                            .saturating_add(pane.inner_rect.width)
+                            .min(area.width)
+                    {
+                        let index = usize::from(area.y.saturating_add(source_y))
+                            * usize::from(target.width)
+                            + usize::from(area.x.saturating_add(x));
+                        if let Some(cell) = target.cells.get_mut(index) {
+                            cell.fg = card.foreground;
+                            cell.bg = card.background;
+                            // Keep links, wide-cell flags, and emphasis; do not fade or invert the card.
+                            cell.modifier &= !(Modifier::DIM | Modifier::REVERSED).bits();
+                        }
+                    }
+                }
+                row = end;
+            }
+        }
+    }
+}
+
+struct PaneRows<'a> {
+    frame: &'a FrameData,
+    pane: &'a PaneSurfacePane,
+}
+
+impl PaneRows<'_> {
+    fn row(&self, y: u16) -> &[CellData] {
+        let rect = self.pane.inner_rect;
+        let start = usize::from(rect.y.saturating_add(y)) * usize::from(self.frame.width)
+            + usize::from(rect.x);
+        self.frame
+            .cells
+            .get(start..start + usize::from(rect.width))
+            .unwrap_or_default()
+    }
+
+    fn cursor_on(&self, y: u16) -> bool {
+        let rect = self.pane.inner_rect;
+        self.frame.cursor.as_ref().is_some_and(|cursor| {
+            cursor.x >= rect.x
+                && cursor.x < rect.x.saturating_add(rect.width)
+                && cursor.y == rect.y.saturating_add(y)
+        })
+    }
+
+    fn message_end(&self, start: u16, agent: Agent) -> Option<u16> {
+        let row = self.row(start);
+        let marker = match agent {
+            Agent::Codex => "›",
+            Agent::Claude => "❯",
+        };
+        if !prefix(row, marker)
+            || self.cursor_on(start)
+            || (start > 0 && !blank(self.row(start - 1)))
+            || !row
+                .iter()
+                .skip(2)
+                .any(|cell| !cell.symbol.trim().is_empty())
+        {
+            return None;
+        }
+        let first = row.first()?;
+        match agent {
+            Agent::Codex => {
+                // Captured history uses bold+dim; composers and menus use bold only.
+                let style = Modifier::BOLD | Modifier::DIM;
+                if first.modifier & style.bits() != style.bits() {
+                    return None;
+                }
+            }
+            Agent::Claude => {
+                // Captured history has a neutral explicit background; the prompt
+                // box and menu marker do not. Light themes use a different gray.
+                terminal_colors::terminal_gray(first.bg)?;
+                terminal_colors::terminal_gray(first.fg)?;
+                if first.modifier & Modifier::REVERSED.bits() != 0 {
+                    return None;
+                }
+            }
+        }
+        let body = row
+            .iter()
+            .skip(2)
+            .rev()
+            .find(|cell| cell.hyperlink.is_none() && !cell.symbol.trim().is_empty())
+            .or_else(|| row.get(2))?;
+        if first.bg != body.bg {
+            return None;
+        }
+        // Attachment and pasted-text labels have their own foreground colors.
+        // The role-specific gutter and common background still identify history.
+        if !same_background(&row[2..], body.bg) {
+            return None;
+        }
+        let mut end = start + 1;
+        while end < self.pane.inner_rect.height {
+            let row = self.row(end);
+            // An explicit background identifies the message's blank padding and
+            // paragraph breaks. Default-background whitespace is not evidence.
+            if blank(row) {
+                if body.bg != 0 && !self.cursor_on(end) && solid_background(row, body.bg) {
+                    end += 1;
+                    continue;
+                }
+                break;
+            }
+            // Stop at blank paragraph boundaries rather than guessing whether the
+            // following indented content belongs to a user, a tool, or a diff.
+            if self.cursor_on(end)
+                || !prefix(row, " ")
+                || !(if body.bg == 0 {
+                    plain_body(&row[2..], body)
+                } else {
+                    same_background(&row[2..], body.bg)
+                })
+                || row
+                    .iter()
+                    .skip(2)
+                    .find(|cell| !cell.symbol.trim().is_empty())
+                    .is_some_and(|cell| cell.symbol == "…" || cell.symbol == "⋮")
+            {
+                break;
+            }
+            end += 1;
+        }
+        Some(end)
+    }
+}
+
+fn prefix(row: &[CellData], marker: &str) -> bool {
+    matches!(row, [first, second, ..] if first.symbol == marker
+        && (second.symbol == " " || second.symbol == "\u{a0}"))
+}
+
+fn blank(row: &[CellData]) -> bool {
+    row.iter().all(|cell| cell.symbol.trim().is_empty())
+}
+
+fn plain_body(row: &[CellData], body: &CellData) -> bool {
+    let end = row
+        .iter()
+        .rposition(|cell| !cell.symbol.trim().is_empty())
+        .map_or(0, |index| index + 1);
+    visible_cells(&row[..end]).all(|cell| {
+        cell.bg == body.bg
+            && (cell.symbol.trim().is_empty()
+                || cell.hyperlink.is_some()
+                || (cell.fg == body.fg && cell.modifier == body.modifier))
+    })
+}
+
+fn same_background(row: &[CellData], background: u32) -> bool {
+    let end = row
+        .iter()
+        .rposition(|cell| !cell.symbol.trim().is_empty())
+        .map_or(0, |index| index + 1);
+    visible_cells(&row[..end]).all(|cell| cell.bg == background)
+}
+
+fn solid_background(row: &[CellData], background: u32) -> bool {
+    !row.is_empty() && row.iter().all(|cell| cell.bg == background)
+}
+
+fn visible_cells(row: &[CellData]) -> impl Iterator<Item = &CellData> {
+    // Retained updates reset the covered half of wide glyphs to default cells,
+    // sometimes without setting `skip`. Their style is not a visible surface.
+    row.iter()
+        .scan(0usize, |covered, cell| {
+            if *covered > 0 {
+                *covered -= 1;
+                Some(None)
+            } else {
+                *covered = UnicodeWidthStr::width(cell.symbol.as_str()).saturating_sub(1);
+                Some(Some(cell))
+            }
+        })
+        .flatten()
+}
