diff --git a/src/client/shell/code_blocks.rs b/src/client/shell/code_blocks.rs
new file mode 100644
index 0000000..896158e
--- /dev/null
+++ b/src/client/shell/code_blocks.rs
@@ -0,0 +1,153 @@
+use super::*;
+use crate::protocol::{CellData, PaneSurfacePane};
+
+/// Client-only decoration. Recognition reads original cells, never the recolored frame.
+pub(super) struct CodeBlocks<'a> {
+    pub(super) snapshot: &'a ClientShellSnapshot,
+    pub(super) surface: &'a PaneSurfaceFrame,
+}
+
+impl CodeBlocks<'_> {
+    fn colors(&self, pane: &PaneSurfacePane) -> Option<(u32, u32)> {
+        let agent = self
+            .snapshot
+            .agents
+            .iter()
+            .find(|agent| agent.pane_id == pane.pane_id)?;
+        if !matches!(
+            agent.agent.as_deref(),
+            Some("codex" | "claude" | "claude-code" | "pi" | "omo" | "custom:senpi")
+        ) {
+            return None;
+        }
+        let owner = self
+            .snapshot
+            .panes
+            .iter()
+            .find(|owner| owner.pane_id == pane.pane_id)?;
+        let workspace = self
+            .snapshot
+            .workspaces
+            .iter()
+            .find(|ws| ws.workspace_id == owner.workspace_id)?;
+        let color = |key| {
+            workspace
+                .tokens
+                .iter()
+                .find(|(name, _)| name == key)
+                .and_then(|(_, value)| terminal_colors::hex_color(value))
+        };
+        Some((color("ultra_code_block_bg")?, color("ultra_code_block_fg")?))
+    }
+
+    pub(super) fn enabled(&self) -> bool {
+        self.surface
+            .panes
+            .iter()
+            .any(|pane| self.colors(pane).is_some())
+    }
+
+    pub(super) fn render(&self, target: &mut FrameData, area: Rect) {
+        for pane in &self.surface.panes {
+            let Some((background, foreground)) = self.colors(pane) else {
+                continue;
+            };
+            let rect = pane.inner_rect;
+            let mut fenced = false;
+            let mut continuation = false;
+            let palette = [foreground; 9];
+            for y in rect.y..rect.y.saturating_add(rect.height).min(area.height) {
+                let start =
+                    usize::from(y) * usize::from(self.surface.frame.width) + usize::from(rect.x);
+                let Some(row) = self
+                    .surface
+                    .frame
+                    .cells
+                    .get(start..start + usize::from(rect.width))
+                else {
+                    break;
+                };
+                let first = row.iter().position(|cell| !cell.symbol.trim().is_empty());
+                let cursor = self.surface.frame.cursor.as_ref().is_some_and(|cursor| {
+                    cursor.y == y
+                        && cursor.x >= rect.x
+                        && cursor.x < rect.x.saturating_add(rect.width)
+                });
+                // Never infer code from an editor, a submitted prompt, or a semantic diff surface.
+                let prompt = row
+                    .first()
+                    .is_some_and(|cell| matches!(cell.symbol.as_str(), "›" | "❯"));
+                let semantic_background = row
+                    .iter()
+                    .any(|cell| cell.bg != 0 && terminal_colors::terminal_gray(cell.bg).is_none());
+                if cursor || prompt || semantic_background {
+                    fenced = false;
+                    continuation = false;
+                    continue;
+                }
+                let fence = first.is_some_and(|x| {
+                    row[x..]
+                        .iter()
+                        .take(3)
+                        .map(|cell| cell.symbol.as_str())
+                        .eq(["`", "`", "`"])
+                });
+                let syntax = first.is_some_and(|x| x >= 2 && syntax_row(row));
+                let closing = continuation
+                    && first.is_some_and(|_| {
+                        row.iter().all(|cell| {
+                            cell.symbol
+                                .chars()
+                                .all(|ch| ch.is_whitespace() || "{}[]();,".contains(ch))
+                        })
+                    });
+                let paint = fence || fenced || syntax || closing;
+                if fence {
+                    fenced = !fenced;
+                }
+                continuation = syntax || closing;
+                if !paint {
+                    continue;
+                }
+                for x in rect.x..rect.x.saturating_add(rect.width).min(area.width) {
+                    let index = usize::from(area.y.saturating_add(y)) * usize::from(target.width)
+                        + usize::from(area.x.saturating_add(x));
+                    if let Some(cell) = target.cells.get_mut(index) {
+                        cell.bg = background;
+                        let fg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.fg));
+                        let bg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(background));
+                        cell.fg = match (fg, bg) {
+                            (Some(fg), Some(bg)) => {
+                                let rgb = crate::ui::readable_foreground(fg, bg, &palette);
+                                u32::from_be_bytes([2, rgb.0, rgb.1, rgb.2])
+                            }
+                            _ => foreground,
+                        };
+                        cell.modifier &= !(Modifier::DIM | Modifier::REVERSED).bits();
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn syntax_row(row: &[CellData]) -> bool {
+    // Native code output carries multiple true-color syntax tokens. Plain prose,
+    // ANSI status colors and a single colored inline link are insufficient.
+    let mut first_color = None;
+    for cell in row {
+        if cell.symbol.trim().is_empty() || cell.hyperlink.is_some() || cell.fg >> 24 != 2 {
+            continue;
+        }
+        let [_, r, g, b] = cell.fg.to_be_bytes();
+        if r.max(g).max(b) - r.min(g).min(b) < 24 {
+            continue;
+        }
+        match first_color {
+            Some(color) if color != cell.fg => return true,
+            None => first_color = Some(cell.fg),
+            _ => {}
+        }
+    }
+    false
+}
