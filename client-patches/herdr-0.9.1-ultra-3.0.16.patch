+use super::*;
+
+fn code_state(colors: (u32, u32)) -> ClientShellState {
+    let mut state = state(
+        "codex",
+        THEMES[2],
+        &[
+            "• assistant answer",
+            "",
+            "  ```rust",
+            "  let answer = 42;",
+            "  }",
+            "  ```",
+            "",
+            "  ordinary prose",
+            "  + semantic diff",
+            "› submitted",
+            "",
+            "› draft",
+        ],
+    );
+    let mut projection = state.snapshot.as_deref().unwrap().clone();
+    projection.workspaces[0].tokens.extend([
+        (
+            "ultra_code_block_bg".into(),
+            format!("#{:06x}", colors.0 & 0xffffff),
+        ),
+        (
+            "ultra_code_block_fg".into(),
+            format!("#{:06x}", colors.1 & 0xffffff),
+        ),
+    ]);
+    state.set_snapshot(Box::new(projection));
+    let source = state.pane_surface.as_mut().unwrap();
+    source.frame.cells[3 * 40 + 2].fg = 0x0289b4fa;
+    source.frame.cells[3 * 40 + 6].fg = 0x02a6e3a1;
+    for cell in &mut source.frame.cells[8 * 40..9 * 40] {
+        cell.bg = 0x02213a2b;
+    }
+    source.frame.cells[11 * 40].modifier = Modifier::BOLD.bits();
+    state
+}
+
+#[test]
+fn red_and_blue_code_surfaces_are_distinct_and_preserve_non_code() {
+    for colors in [(0x02e9ddff, 0x02302044), (0x02123b70, 0x02e1efff)] {
+        let mut state = code_state(colors);
+        let original = state.pane_surface.as_ref().unwrap().frame.clone();
+        let frame = state.compose(106, 24).unwrap();
+        for y in 2..=5 {
+            assert!(
+                composed_row(&state, &frame, y)
+                    .iter()
+                    .all(|cell| cell.bg == colors.0),
+                "code row {y}"
+            );
+        }
+        for y in [0, 1, 6, 7, 8, 9, 10, 11] {
+            assert!(
+                composed_row(&state, &frame, y)
+                    .iter()
+                    .all(|cell| cell.bg != colors.0),
+                "non-code row {y}"
+            );
+        }
+        assert_eq!(composed_row(&state, &frame, 8)[0].bg, 0x02213a2b);
+        assert_eq!(
+            state.pane_surface.as_ref().unwrap().frame.cells,
+            original.cells
+        );
+        for cell in composed_row(&state, &frame, 3) {
+            if cell.symbol.trim().is_empty() {
+                continue;
+            }
+            let fg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.fg)).unwrap();
+            let bg = crate::ui::color_to_rgb(crate::protocol::u32_to_color(cell.bg)).unwrap();
+            let a = crate::ui::relative_luminance(fg);
+            let b = crate::ui::relative_luminance(bg);
+            assert!((a.max(b) + 0.05) / (a.min(b) + 0.05) >= 4.5);
+        }
+    }
+}
+
+#[test]
+fn code_colors_follow_pane_owner_and_clear_when_tokens_are_removed() {
+    let colors = (0x02123b70, 0x02e1efff);
+    let mut state = code_state(colors);
+    let mut snapshot = state.snapshot.as_deref().unwrap().clone();
+    let mut other = snapshot.workspaces[0].clone();
+    other.workspace_id = "other".into();
+    other.tokens.clear();
+    snapshot.workspaces.push(other);
+    snapshot.focused_workspace_id = Some("other".into());
+    state.set_snapshot(Box::new(snapshot.clone()));
+    let frame = state.compose(106, 24).unwrap();
+    assert_eq!(composed_row(&state, &frame, 3)[0].bg, colors.0);
+    snapshot.workspaces[0]
+        .tokens
+        .retain(|(key, _)| !key.starts_with("ultra_code_block"));
+    state.set_snapshot(Box::new(snapshot));
+    let frame = state.compose(106, 24).unwrap();
+    assert_ne!(composed_row(&state, &frame, 3)[0].bg, colors.0);
+}
+
+#[test]
+fn syntax_without_fences_survives_scroll_but_plain_prose_does_not_become_code() {
+    let mut state = code_state((0x02123b70, 0x02e1efff));
+    let source = state.pane_surface.as_mut().unwrap();
+    for row in [2, 5] {
+        for cell in &mut source.frame.cells[row * 40..(row + 1) * 40] {
+            cell.symbol = " ".into();
+        }
+    }
+    let frame = state.compose(106, 24).unwrap();
+    assert_eq!(composed_row(&state, &frame, 3)[0].bg, 0x02123b70);
+    assert_eq!(composed_row(&state, &frame, 4)[0].bg, 0x02123b70);
+    assert_ne!(composed_row(&state, &frame, 7)[0].bg, 0x02123b70);
+}
+
+#[test]
+fn code_patch_and_full_frame_have_identical_colors() {
+    let colors = (0x02e9ddff, 0x02302044);
+    let mut state = code_state(colors);
+    state.compose(106, 24).unwrap();
+    let source = state.pane_surface.as_ref().unwrap();
+    let mut cell = source.frame.cells[3 * 40 + 2].clone();
+    cell.symbol = "x".into();
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: source.boot_id.clone(),
+        projection_revision: source.projection_revision,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows: vec![crate::protocol::PaneSurfacePatchRow {
+            x: 2,
+            y: 3,
+            cells: vec![cell.clone()],
+        }],
+        panes: source.panes.clone(),
+        cursor: None,
+    };
+    assert!(matches!(
+        state.apply_pane_surface_patch(patch),
+        ClientPaneSurfacePatchOutcome::Applied(None)
+    ));
+    let patched = state.compose(106, 24).unwrap();
+    let mut fresh = code_state(colors);
+    fresh.pane_surface.as_mut().unwrap().frame.cells[3 * 40 + 2] = cell;
+    assert_eq!(patched.cells, fresh.compose(106, 24).unwrap().cells);
+}
+
+#[test]
+fn code_overlay_fixed_geometry_one_and_fifteen_panes() {
+    for count in [1_u16, 15] {
+        let state = code_state((0x02123b70, 0x02e1efff));
+        let mut snapshot = state.snapshot.as_deref().unwrap().clone();
+        let mut surface = state.pane_surface.as_ref().unwrap().clone();
+        let cells = surface.frame.cells.clone();
+        surface.frame.height = 180;
+        surface.frame.cells = (0..15).flat_map(|_| cells.iter().cloned()).collect();
+        let pane = surface.panes[0].clone();
+        let owner = snapshot.panes[0].clone();
+        let agent = snapshot.agents[0].clone();
+        surface.panes.clear();
+        snapshot.panes.clear();
+        snapshot.agents.clear();
+        for index in 0..count {
+            let id = format!("code_{index}");
+            let mut pane = pane.clone();
+            pane.pane_id = id.clone();
+            pane.inner_rect.y = index * 12;
+            pane.rect = pane.inner_rect;
+            surface.panes.push(pane);
+            let mut owner = owner.clone();
+            owner.pane_id = id.clone();
+            snapshot.panes.push(owner);
+            let mut agent = agent.clone();
+            agent.pane_id = id;
+            snapshot.agents.push(agent);
+        }
+        let overlay = super::super::super::code_blocks::CodeBlocks {
+            snapshot: &snapshot,
+            surface: &surface,
+        };
+        let mut target = surface.frame.clone();
+        let started = std::time::Instant::now();
+        for _ in 0..100 {
+            overlay.render(std::hint::black_box(&mut target), Rect::new(0, 0, 40, 180));
+        }
+        eprintln!(
+            "code overlay: {count} panes, 100 renders, {:?}",
+            started.elapsed()
+        );
+        for index in 0..count {
+            assert_eq!(
+                target.cells[usize::from(index * 12 + 3) * 40].bg,
+                0x02123b70
+            );
+        }
+    }
+}
diff --git a/src/client/shell/tests/terminal_user_messages/live.rs b/src/client/shell/tests/terminal_user_messages/live.rs
new file mode 100644
index 0000000..ab17bfc
--- /dev/null
+++ b/src/client/shell/tests/terminal_user_messages/live.rs
@@ -0,0 +1,130 @@
+use super::*;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+struct Captures {
+    samples: Vec<Sample>,
+}
+
+#[derive(Deserialize)]
+struct Sample {
+    name: String,
+    agent: String,
+    theme: String,
+    fragments: Vec<Fragment>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Fragment {
+    history_row: Option<u16>,
+    ansi: String,
+    columns: u16,
+}
+
+#[tokio::test]
+async fn actual_active_terminal_captures_render_distinct_user_cards() {
+    // Given captured live SGR and gutters, with private text masked at equal cell widths.
+    let captures: Captures = serde_json::from_str(include_str!("live_captures.json")).unwrap();
+    let mut fragments_checked = 0;
+    let mut user_rows_checked = 0;
+    for sample in &captures.samples {
+        let (colors, background, foreground) = match sample.theme.as_str() {
+            "blue" => (THEMES[0], "#000000", "#d4d4d4"),
+            "pink" => (THEMES[1], "#fffafa", "#30252b"),
+            "red" => (THEMES[2], "#0b0b0e", "#d4d4d4"),
+            other => panic!("unknown captured theme: {other}"),
+        };
+        for fragment in &sample.fragments {
+            let width = fragment.columns;
+            let height = u16::try_from(fragment.ansi.lines().count())
+                .unwrap()
+                .saturating_add(2);
+            let pane = crate::pane::PaneRuntime::test_with_screen_bytes(
+                width,
+                height,
+                fragment.ansi.as_bytes(),
+            );
+            let backend = ratatui::backend::TestBackend::new(width, height);
+            let mut terminal = ratatui::Terminal::new(backend).unwrap();
+            let mut source = surface();
+            terminal
+                .draw(|frame| {
+                    pane.render(frame, Rect::new(0, 0, width, height), false);
+                    source.frame = FrameData::from_ratatui_buffer_with_hyperlinks(
+                        frame.buffer_mut(),
+                        None,
+                        &[],
+                    );
+                })
+                .unwrap();
+            source.panes[0].rect = Rect::new(0, 0, width, height).into();
+            source.panes[0].inner_rect = source.panes[0].rect;
+            let raw = source.frame.clone();
+            let mut state = state(&sample.agent, colors, &[]);
+            let mut projection = state.snapshot.as_deref().unwrap().clone();
+            let tokens = &mut projection.workspaces[0].tokens;
+            tokens.retain(|(key, _)| {
+                !matches!(key.as_str(), "ultra_terminal_fg" | "ultra_terminal_bg")
+                    && (sample.theme == "pink" || key != "ultra_terminal_palette")
+            });
+            tokens.extend([
+                ("ultra_terminal_fg".into(), foreground.into()),
+                ("ultra_terminal_bg".into(), background.into()),
+            ]);
+            state.set_snapshot(Box::new(projection));
+            state.set_pane_surface(source);
+            // When real terminal parsing and native shell composition process the captured cells.
+            let frame = state
+                .compose(width.saturating_add(60), height.saturating_add(12))
+                .unwrap();
+            // Then history is colored, while composer, diff/model content, and geometry survive.
+            for y in 0..height {
+                let actual = composed_row(&state, &frame, y);
+                let row_start = usize::from(y) * usize::from(width);
+                let original = &raw.cells[row_start..row_start + usize::from(width)];
+                for (cell, before) in actual.iter().zip(original) {
+                    assert_eq!(
+                        (&cell.symbol, cell.skip, cell.hyperlink),
+                        (&before.symbol, before.skip, before.hyperlink),
+                        "{} row {y}",
+                        sample.name
+                    );
+                }
+                if fragment.history_row == Some(y) {
+                    assert!(
+                        actual.iter().all(|cell| (cell.bg, cell.fg) == colors),
+                        "{} history row {y} did not use the configured card colors",
+                        sample.name
+                    );
+                    user_rows_checked += 1;
+                } else if fragment.history_row.is_none()
+                    || original.iter().any(|cell| cell.bg == 0x02213a2b)
+                {
+                    let mut expected = original.to_vec();
+                    for cell in &mut expected {
+                        apply_terminal_colors(
+                            cell,
+                            terminal_colors(state.snapshot.as_deref().unwrap()),
+                        );
+                    }
+                    assert_eq!(actual, expected, "{} non-user row {y}", sample.name);
+                }
+            }
+            assert_eq!(
+                state.pane_surface.as_ref().unwrap().frame.cells,
+                raw.cells,
+                "{} source cells changed",
+                sample.name
+            );
+            fragments_checked += 1;
+        }
+    }
+    assert!(user_rows_checked > 0);
+    eprintln!(
+        "live_samples={} fragments={} user_rows={}",
+        captures.samples.len(),
+        fragments_checked,
+        user_rows_checked
+    );
+}
