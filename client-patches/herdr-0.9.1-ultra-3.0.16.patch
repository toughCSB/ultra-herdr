+use super::*;
+
+mod claude;
+mod code_blocks;
+mod live;
+mod msi;
+mod ownership;
+mod patches;
+mod replay;
+mod scaling;
+
+const THEMES: [(u32, u32); 3] = [
+    (0x02a8e1fb, 0x020b2c45),
+    (0x02f4a0bf, 0x02480d30),
+    (0x02ffb3b8, 0x02650d18),
+];
+
+fn state(agent: &str, colors: (u32, u32), lines: &[&str]) -> ClientShellState {
+    let mut projection = snapshot();
+    projection.workspaces[0].tokens = vec![
+        ("ultra_terminal_bg".into(), "#fffafa".into()),
+        ("ultra_terminal_fg".into(), "#30252b".into()),
+        (
+            "ultra_terminal_palette".into(),
+            "#30252b,#b42318,#146b3a,#8a4b00,#244da8,#74338f,#006a73,#68505c,#9b235f".into(),
+        ),
+        (
+            "ultra_user_message_bg".into(),
+            format!("#{:06x}", colors.0 & 0xffffff),
+        ),
+        (
+            "ultra_user_message_fg".into(),
+            format!("#{:06x}", colors.1 & 0xffffff),
+        ),
+    ];
+    projection.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: Some(agent.into()),
+        agent: Some(agent.into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 0,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    });
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projection));
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 40, 12));
+    for (y, line) in lines.iter().enumerate() {
+        let y = u16::try_from(y).unwrap();
+        buffer.set_string(0, y, *line, Style::default());
+        if line.starts_with("› ") {
+            buffer[(0, y)].set_style(Style::default().add_modifier(Modifier::BOLD | Modifier::DIM));
+            buffer[(1, y)].set_style(Style::default().add_modifier(Modifier::BOLD | Modifier::DIM));
+        }
+    }
+    let mut source = surface();
+    source.frame = FrameData::from_ratatui_buffer_with_hyperlinks(&buffer, None, &[]);
+    source.panes[0].inner_rect = buffer.area.into();
+    source.panes[0].rect = buffer.area.into();
+    state.set_pane_surface(source);
+    state
+}
+
+fn composed_row<'a>(
+    state: &ClientShellState,
+    frame: &'a FrameData,
+    y: u16,
+) -> &'a [crate::protocol::CellData] {
+    let rect = state.hits.panes[0].inner_rect;
+    let start = usize::from(rect.y + y) * usize::from(frame.width) + usize::from(rect.x);
+    &frame.cells[start..start + usize::from(rect.width)]
+}
+
+#[test]
+fn history_uses_exact_workspace_colors_when_wrapped_multiline_and_cjk() {
+    for colors in THEMES {
+        // Given real Codex marker attributes and already-wrapped terminal cells.
+        let mut state = state(
+            "codex",
+            colors,
+            &[
+                "",
+                "› 질문 한글과 漢字",
+                "  wrapped continuation",
+                "  explicit newline",
+                "",
+                "• assistant answer",
+                "  tool output",
+                "",
+                "› Ask Codex",
+                "",
+            ],
+        );
+        let source = state.pane_surface.as_mut().unwrap();
+        source.frame.cells[8 * 40].modifier = Modifier::BOLD.bits();
+        source
+            .frame
+            .hyperlinks
+            .push("https://example.test/path".into());
+        source.frame.cells[40 + 2].hyperlink = Some(0);
+        let original = source.frame.clone();
+        // When composing through the actual shell, including generic foreground correction.
+        let frame = state.compose(106, 24).unwrap();
+        // Then only the user rows become cards; text geometry and source remain intact.
+        for y in 0..12_u16 {
+            for (x, cell) in composed_row(&state, &frame, y).iter().enumerate() {
+                let raw = &original.cells[usize::from(y) * 40 + x];
+                assert_eq!(
+                    (&cell.symbol, cell.skip, cell.hyperlink),
+                    (&raw.symbol, raw.skip, raw.hyperlink)
+                );
+                if (1..=3).contains(&y) {
+                    assert_eq!((cell.bg, cell.fg), colors);
+                    assert_eq!(
+                        cell.modifier & (Modifier::DIM | Modifier::REVERSED).bits(),
+                        0
+                    );
+                } else {
+                    let mut expected = raw.clone();
+                    apply_terminal_colors(
+                        &mut expected,
+                        terminal_colors(state.snapshot.as_deref().unwrap()),
+                    );
+                    assert_eq!(cell, &expected);
+                }
+            }
+        }
+        assert_eq!(frame.hyperlinks, original.hyperlinks);
+        assert_eq!(
+            state.pane_surface.as_ref().unwrap().frame.cells,
+            original.cells
+        );
+    }
+}
+
+#[test]
+fn cards_use_pane_owner_when_focus_and_viewer_differ() {
+    // Given a Pink pane while the focused workspace and viewer have other colors.
+    let mut state = state("codex", THEMES[1], &["› submitted", ""]);
+    let mut projection = state.snapshot.as_deref().unwrap().clone();
+    let mut other = projection.workspaces[0].clone();
+    other.workspace_id = "ws_other".into();
+    other.tokens = vec![
+        ("ultra_user_message_bg".into(), "#ffb3b8".into()),
+        ("ultra_user_message_fg".into(), "#650d18".into()),
+    ];
+    projection.workspaces.push(other);
+    projection.focused_workspace_id = Some("ws_other".into());
+    state.config.palette.panel_bg = ratatui::style::Color::Blue;
+    state.set_snapshot(Box::new(projection));
+    // When composing the pane.
+    let frame = state.compose(106, 24).unwrap();
+    // Then pane ownership wins over focus and viewer chrome.
+    assert!(composed_row(&state, &frame, 0)
+        .iter()
+        .all(|cell| (cell.bg, cell.fg) == THEMES[1]));
+}
+
+#[test]
+fn plain_menu_and_composer_markers_do_not_become_cards() {
+    // Given the same glyph without the history-only DIM attribute.
+    let mut state = state(
+        "codex",
+        THEMES[0],
+        &[
+            "› 1. Yes",
+            "  2. No",
+            "",
+            "› Ask Codex",
+            "  draft continuation",
+        ],
+    );
+    for row in [0, 3] {
+        state.pane_surface.as_mut().unwrap().frame.cells[row * 40].modifier = Modifier::BOLD.bits();
+    }
+    // When rendering.
+    let frame = state.compose(106, 24).unwrap();
+    // Then neither the options nor the composer is painted.
+    for row in 0..5 {
+        assert!(composed_row(&state, &frame, row)
+            .iter()
+            .all(|cell| cell.bg != THEMES[0].0));
+    }
+}
+
+#[test]
+fn colored_diff_and_collapsed_rows_end_history_cards() {
+    for collapsed in [false, true] {
+        // Given history immediately followed by a diff or collapsed-content row.
+        let mut state = state(
+            "codex",
+            THEMES[2],
+            &[
+                "› submitted",
+                if collapsed {
+                    "  … collapsed"
+                } else {
+                    "  + added code"
+                },
+                "  later tool",
+                "",
+            ],
+        );
+        if !collapsed {
+            let source = state.pane_surface.as_mut().unwrap();
+            for cell in &mut source.frame.cells[40..80] {
+                cell.bg = 0x02213a2b;
+            }
+        }
+        // When rendering.
+        let frame = state.compose(106, 24).unwrap();
+        // Then the marker row is painted, but none of the following output is.
+        assert_eq!(composed_row(&state, &frame, 0)[0].bg, THEMES[2].0);
+        for y in 1..3 {
+            let source = &state.pane_surface.as_ref().unwrap().frame;
+            let mut expected = source.cells[usize::from(y) * 40..usize::from(y + 1) * 40].to_vec();
+            for cell in &mut expected {
+                apply_terminal_colors(cell, terminal_colors(state.snapshot.as_deref().unwrap()));
+            }
+            assert_eq!(composed_row(&state, &frame, y), expected);
+        }
+    }
+}
+
+#[test]
+fn pi_and_unknown_agents_keep_their_existing_styling() {
+    for agent in ["pi", "omo", "unknown"] {
+        // Given another application's own card, even with a Codex-looking marker.
+        let mut state = state(agent, THEMES[1], &["› own card", "  body", ""]);
+        let source = state.pane_surface.as_mut().unwrap();
+        for cell in &mut source.frame.cells[..80] {
+            cell.bg = 0x02a8e1fb;
+            cell.fg = 0x020b2c45;
+        }
+        let mut expected = source.frame.cells[..80].to_vec();
+        for cell in &mut expected {
+            apply_terminal_colors(cell, terminal_colors(state.snapshot.as_deref().unwrap()));
+        }
+        // When rendering.
+        let frame = state.compose(106, 24).unwrap();
+        // Then the new feature makes no changes to the application's styling.
+        assert_eq!(composed_row(&state, &frame, 0), &expected[..40]);
+        assert_eq!(composed_row(&state, &frame, 1), &expected[40..]);
+    }
+}
