+}
+
+#[test]
+fn pink_codex_drag_uses_client_selection_without_changing_dark_mouse_input() {
+    for light in [true, false] {
+        let mut state = themed_state(0x02ffff00, 0, light);
+        state.config.copy_on_select = true;
+        let mut value = state.snapshot.as_deref().expect("snapshot").clone();
+        value.agents.push(ClientShellAgent {
+            pane_id: "pane_1".into(),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: None,
+            display_agent: Some("codex".into()),
+            agent: Some("codex".into()),
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Idle,
+            state_change_seq: 0,
+            state_labels: Vec::new(),
+            tokens: Vec::new(),
+            focused: true,
+        });
+        state.set_snapshot(Box::new(value));
+        let mut value = surface();
+        value.panes[0].mouse_reporting = true;
+        state.set_pane_surface(value);
+        state.compose(106, 20).expect("frame");
+        let pane = state.hits.panes[0].clone();
+        let down = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: pane.inner_rect.x,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert!(matches!(&down.requests[..], [ClientMessage::ClientShellPaneInput { .. }]));
+        let drag = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Drag(MouseButton::Left),
+            column: pane.inner_rect.x + 2,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert!(matches!(
+            &drag.requests[..],
+            [ClientMessage::ClientShellPaneInput { events, .. }]
+                if matches!(&events[..], [ClientPaneInputEvent::Mouse { kind, .. }]
+                    if *kind == if light {
+                        crate::protocol::ClientMouseKind::Up(crate::protocol::ClientMouseButton::Left)
+                    } else {
+                        crate::protocol::ClientMouseKind::Drag(crate::protocol::ClientMouseButton::Left)
+                    })
+        ));
+        state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column: pane.inner_rect.x + 2,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert_eq!(state.selection.is_some(), light);
+        if light {
+            let frame = state.compose(106, 20).expect("selected frame");
+            let cell = &frame.cells[usize::from(pane.inner_rect.y) * usize::from(frame.width)
+                + usize::from(pane.inner_rect.x)];
+            assert_eq!(cell.bg, 0x029b235f);
+            assert_eq!(cell.fg, 0x02ffffff);
+        }
+    }
+}
